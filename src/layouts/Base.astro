---
// Document shell shared by every page: <head>, fonts, global styles.
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Title used for social previews. Defaults to `title`. */
  ogTitle?: string;
  /** Trail between "Home" and this page, for search engines. Defaults to just this page. */
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, ogTitle = title, breadcrumbs } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path, Astro.site);
const site = new URL("/", Astro.site).href.replace(/\/$/, "");

// Structured data for search engines.
const organization = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "Handsdown",
      url: site,
      description:
        "Handsdown is an AI-first staff augmentation company: senior engineers, designers, data and product specialists from Latin America who join your team and work your hours.",
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      name: "Handsdown",
      url: site,
      publisher: { "@id": `${site}/#organization` },
    },
  ],
};
const trail =
  path === "/"
    ? []
    : [
        { name: "Home", path: "" },
        ...(breadcrumbs ?? [{ name: ogTitle, path }]),
      ];
const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trail.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: site + crumb.path,
  })),
};
---

<!doctype html>
<html lang="en" class="www-site-type">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Handsdown" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    {trail.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbList)}
      />
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Set before first paint so sections start in their "out of focus" state
      // instead of flashing their final state (see src/styles/motion.css).
      document.documentElement.dataset.motion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches
        ? "reduced"
        : "full";
    </script>
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-4.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="www-page">
      <slot />
    </div>
    <noscript>
      <!-- Without JavaScript nothing triggers the scroll reveal: show everything. -->
      <style>
        [data-reveal="out"] {
          opacity: 1;
          filter: none;
          transform: none;
        }
      </style>
    </noscript>
    <script>
      import "../scripts/site/reveal.ts";
      import "../scripts/site/prompts.ts";
    </script>
  </body>
</html>
