---
---

<div data-reveal="out">
  <section
    aria-labelledby="what-shapes-your-rate"
    class="px-6 py-20 md:py-[109px]"
  >
    <div class="mx-auto max-w-[1080px]">
      <p class="text-gradient-heading text-[13px] leading-5 font-medium tracking-[0.12em] uppercase md:text-[14px]">
        Why the fit holds
      </p>
      <h2
        id="what-shapes-your-rate"
        class="mt-6 text-[40px] leading-[1.2] font-medium tracking-[-0.04em] text-text-primary md:text-[58px]"
      >
        <span class="block">Set by the specialist </span>
        <span class="block text-gradient-heading">your team needs.</span>
      </h2>
      <button
        type="button"
        class="mt-6 inline-flex h-11 items-center gap-3 rounded-full border border-slate-800 bg-background-inverted px-5 text-[14px] font-medium tracking-[-0.04em] text-text-inverse-primary shadow-dark-btn transition duration-120 ease-standard hover:bg-background-inverted-hover focus-visible:shadow-ring focus-visible:outline-none active:translate-y-px motion-reduce:transition-none"
      >
        Run the search<span aria-hidden="true">→</span>
      </button>
      <ol class="mt-12 grid gap-2 md:mt-[60px] md:grid-cols-3 md:gap-12">
        <li class="flex flex-col gap-5 py-6 md:py-10">
          <span
            aria-hidden="true"
            class="font-mono text-[11px] leading-4 font-bold tracking-[0.15em] text-text-accent"
          >
            01
          </span>
          <p class="text-[20px] leading-[1.2] font-medium tracking-[-0.03em] text-text-primary md:text-[24px]">
            The domain and function: engineering, design, data, product.
          </p>
        </li>
        <li class="flex flex-col gap-5 py-6 md:py-10">
          <span
            aria-hidden="true"
            class="font-mono text-[11px] leading-4 font-bold tracking-[0.15em] text-text-accent"
          >
            02
          </span>
          <p class="text-[20px] leading-[1.2] font-medium tracking-[-0.03em] text-text-primary md:text-[24px]">
            Years of experience, depth of ownership, and the complexity they can
            navigate independently.
          </p>
        </li>
        <li class="flex flex-col gap-5 py-6 md:py-10">
          <span
            aria-hidden="true"
            class="font-mono text-[11px] leading-4 font-bold tracking-[0.15em] text-text-accent"
          >
            03
          </span>
          <p class="text-[20px] leading-[1.2] font-medium tracking-[-0.03em] text-text-primary md:text-[24px]">
            Full-time or part-time, short engagement or ongoing, solo or team
            lead.
          </p>
        </li>
      </ol>
    </div>
  </section>
</div>
