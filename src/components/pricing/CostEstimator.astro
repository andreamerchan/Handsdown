---
// The numbers, labels and formula live in src/data/pricing.ts.
// This renders the default selection; src/scripts/pricing/cost-estimator.ts updates it.
import {
  DISCIPLINES,
  SENIORITIES,
  DEFAULT_DISCIPLINE,
  DEFAULT_SENIORITY,
  describeEstimate,
} from "../../data/pricing";

const view = describeEstimate(DEFAULT_DISCIPLINE, DEFAULT_SENIORITY);
---

<section aria-labelledby="cost-estimator" class="px-6 py-20 md:py-[109px]">
  <div class="mx-auto max-w-[1080px]">
    <p class="text-gradient-heading text-[13px] leading-5 font-medium tracking-[0.12em] uppercase md:text-[14px]">
      Why the fit holds
    </p>
    <h2
      id="cost-estimator"
      class="mt-6 text-[36px] leading-[1.2] font-medium tracking-[-0.04em] text-text-primary md:text-[58px]"
    >
      <span class="block">Know the range up front. </span>
      <span class="block text-balance text-gradient-heading">
        The exact rate follows the role.
      </span>
    </h2>
    <div class="mt-12 grid gap-6 rounded-3xl bg-background-neutral-faint p-4 md:mt-[60px] md:px-[26px] md:py-6 lg:grid-cols-[377px_minmax(0,1fr)]">
      <div class="flex flex-col gap-7 rounded-xl bg-background-raised px-3.5 py-4">
        <label class="flex flex-col gap-2">
          <span class="text-[12px] font-semibold tracking-[0.04em] text-text-tertiary uppercase">
            Discipline
          </span>
          <span class="relative block">
            <select class="h-[46px] w-full appearance-none rounded-full border border-border-default bg-background-neutral-faint pr-11 pl-4 text-[14px] font-medium text-text-primary focus-visible:shadow-ring focus-visible:outline-none">
              {
                DISCIPLINES.map((discipline) => (
                  <option value={discipline.id} selected={discipline.id === DEFAULT_DISCIPLINE}>
                    {discipline.label}
                  </option>
                ))
              }
            </select>
            <svg
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-text-secondary"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="m4 6 4 4 4-4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </label>
        <fieldset class="flex flex-col gap-2.5">
          <legend class="mb-2.5 font-mono text-[12px] leading-[14px] font-medium tracking-[0.15em] text-text-tertiary uppercase">
            Seniority
          </legend>
          <div class="flex gap-0.5 rounded-full bg-background-neutral-faint p-1">
            {
              SENIORITIES.map((seniority) => (
                <label class="flex-1 cursor-pointer">
                  <input
                    type="radio"
                    class="peer sr-only"
                    name="estimate-seniority"
                    checked={seniority.id === DEFAULT_SENIORITY}
                    value={seniority.id}
                  />
                  <span class="flex min-h-11 items-center justify-center rounded-full px-3.5 text-[13px] font-medium text-text-tertiary transition-colors duration-120 peer-checked:bg-background-inverted peer-checked:text-text-inverse-primary peer-focus-visible:shadow-ring">
                    {seniority.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p class="text-[12px] leading-5 text-text-tertiary">
          Full-time engagement. Your exact rate is confirmed in writing before
          anything starts.
        </p>
      </div>
      <div class="flex flex-col gap-8 rounded-xl bg-background-raised p-6 md:p-9">
        <p class="text-[12px] font-semibold tracking-[0.04em] text-text-tertiary uppercase">
          Simulation
        </p>
        <div class="flex flex-col gap-5">
          <div aria-hidden="true">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span class="text-[13px] font-medium text-text-primary">
                Handsdown specialist, full-time
              </span>
              <span class="text-[14px] font-semibold text-text-primary tabular-nums">
                {view.ours.amount}
                <span class="text-[12px] font-normal text-text-tertiary">
                  {" "}
                  / mo*
                </span>
              </span>
            </div>
            <div class="relative mt-2.5 h-10 overflow-hidden rounded-xl bg-background-neutral-faint">
              <span
                class="absolute inset-y-0 left-0 rounded-l-xl bg-gradient-hero"
                style={`width:${view.ours.lowPercent}%`}
              ></span>
              <span
                class="absolute inset-y-0 rounded-r-xl bg-gradient-hero opacity-45"
                style={`left:${view.ours.lowPercent}%;width:${view.ours.spreadPercent}%`}
              ></span>
            </div>
          </div>
          <div>
            <div aria-hidden="true">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <span class="text-[13px] font-medium text-text-primary">
                  Same hire in-house in the US, fully loaded
                </span>
                <span class="text-[14px] font-semibold text-text-primary tabular-nums">
                  {view.usInHouse.amount}
                  <span class="text-[12px] font-normal text-text-tertiary">
                    {" "}
                    / mo*
                  </span>
                </span>
              </div>
              <div class="relative mt-2.5 h-10 overflow-hidden rounded-xl bg-background-neutral-faint">
                <span
                  class="absolute inset-y-0 left-0 rounded-l-xl bg-indigo-500/25"
                  style={`width:${view.usInHouse.lowPercent}%`}
                ></span>
                <span
                  class="absolute inset-y-0 rounded-r-xl bg-gradient-hero opacity-50"
                  style={`left:${view.usInHouse.lowPercent}%;width:${view.usInHouse.spreadPercent}%`}
                ></span>
              </div>
            </div>
            <div
              class="mt-3 sm:pl-[var(--keep-at)]"
              style={`--keep-at:${view.keepOffsetPercent}%`}
            >
              <p class="flex items-center gap-1.5 font-mono text-[11px] leading-[13.5px] lg:text-[9px] font-medium tracking-[0.17em] text-text-accent uppercase">
                <span class="size-1.5 rounded-full bg-gradient-hero"></span>What
                you keep
              </p>
              <p class="mt-1 text-[13px] text-text-primary">
                <span class="font-semibold">{view.keepShare}</span>
                <span class="text-[12px] text-text-secondary">{view.keepYearly}</span>
              </p>
            </div>
          </div>
        </div>
        <p aria-live="polite" class="sr-only">{view.announcement}</p>
        <div class="flex flex-col-reverse items-stretch gap-3 border-t border-border-default pt-6 sm:flex-row sm:items-center sm:justify-end sm:gap-5">
          <a
            href="/book"
            class="inline-flex min-h-11 items-center justify-center text-[14px] font-medium tracking-[-0.04em] text-text-accent hover:underline focus-visible:shadow-ring focus-visible:outline-none"
          >
            Get your exact rate in writing <span aria-hidden="true"> →</span>
          </a>
          <button
            type="button"
            class="inline-flex h-11 items-center justify-center rounded-full border border-slate-800 bg-background-inverted px-7 text-[14px] font-medium tracking-[-0.04em] text-text-inverse-primary shadow-dark-btn transition duration-120 ease-standard hover:bg-background-inverted-hover focus-visible:shadow-ring focus-visible:outline-none active:translate-y-px motion-reduce:transition-none"
          >
            Describe your role
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/pricing/cost-estimator.ts";
</script>
