---
---

<section
  aria-labelledby="pricing-close"
  class="bg-background-inverted px-6 py-24 md:py-[150px]"
>
  <div class="mx-auto flex max-w-[1080px] flex-col items-center text-center">
    <h2
      id="pricing-close"
      class="text-[40px] leading-[1.2] font-medium tracking-[-0.04em] text-text-inverse-primary md:text-[58px]"
    >
      <span class="block">Tell us what </span>
      <span class="block text-gradient-heading">your team needs.</span>
    </h2>
    <p class="mt-7 max-w-[678px] text-[17px] leading-[1.6] tracking-[-0.02em] text-text-inverse-primary md:text-[20px]">
      One sentence is enough. We'll take it from there and introduce the
      specialists who fit.
    </p>
    <form class="relative mt-12 w-full max-w-[736px] md:mt-[60px]">
      <label class="block">
        <span class="sr-only">Tell us what your team needs</span>
        <input
          type="text"
          placeholder="Describe your role, e.g. a senior RAG engineer with US-hours overlap"
          class="h-[60px] w-full rounded-full border-[0.75px] border-indigo-500/[0.32] bg-white/[0.92] pr-[64px] pl-[26px] text-sm text-ellipsis text-text-primary placeholder:text-text-tertiary focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none sm:pr-[150px]"
          value=""
        />
      </label>
      <button
        type="submit"
        aria-label="Match me"
        class="absolute inset-y-2 right-2 inline-flex w-11 items-center justify-center gap-3 rounded-full border border-slate-800 bg-background-inverted text-[14px] font-semibold text-text-inverse-primary shadow-dark-btn transition duration-120 ease-standard hover:bg-background-inverted-hover focus-visible:shadow-ring focus-visible:outline-none active:translate-y-px motion-reduce:transition-none sm:w-auto sm:px-5"
      >
        <span aria-hidden="true" class="max-sm:hidden">
          Match me
        </span>
        <span aria-hidden="true">→</span>
      </button>
    </form>
    <ul
      aria-label="Examples"
      class="mt-7 flex max-w-[620px] flex-wrap justify-center gap-2.5"
    >
      <li>
        <button
          type="button"
          class="inline-flex min-h-11 items-center rounded-full bg-white/[0.06] px-5 text-[14px] font-medium text-text-inverse-primary transition-colors duration-120 hover:bg-white/[0.12] focus-visible:shadow-ring focus-visible:outline-none"
        >
          Senior backend engineer
        </button>
      </li>
      <li>
        <button
          type="button"
          class="inline-flex min-h-11 items-center rounded-full bg-white/[0.06] px-5 text-[14px] font-medium text-text-inverse-primary transition-colors duration-120 hover:bg-white/[0.12] focus-visible:shadow-ring focus-visible:outline-none"
        >
          DevOps &amp; cloud
        </button>
      </li>
      <li>
        <button
          type="button"
          class="inline-flex min-h-11 items-center rounded-full bg-white/[0.06] px-5 text-[14px] font-medium text-text-inverse-primary transition-colors duration-120 hover:bg-white/[0.12] focus-visible:shadow-ring focus-visible:outline-none"
        >
          Product designer
        </button>
      </li>
      <li>
        <button
          type="button"
          class="inline-flex min-h-11 items-center rounded-full bg-white/[0.06] px-5 text-[14px] font-medium text-text-inverse-primary transition-colors duration-120 hover:bg-white/[0.12] focus-visible:shadow-ring focus-visible:outline-none"
        >
          Data engineer
        </button>
      </li>
      <li>
        <button
          type="button"
          class="inline-flex min-h-11 items-center rounded-full bg-white/[0.06] px-5 text-[14px] font-medium text-text-inverse-primary transition-colors duration-120 hover:bg-white/[0.12] focus-visible:shadow-ring focus-visible:outline-none"
        >
          Full-stack squad
        </button>
      </li>
    </ul>
  </div>
</section>
