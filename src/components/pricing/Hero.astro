---
---

<section
  aria-labelledby="pricing-hero"
  class="px-6 pt-16 pb-20 md:pt-[110px] md:pb-[120px]"
>
  <div class="mx-auto flex max-w-[730px] flex-col items-center text-center">
    <p class="text-gradient-heading text-[13px] leading-5 font-medium tracking-[0.15em] uppercase md:text-[14px]">
      Pricing
    </p>
    <h1
      id="pricing-hero"
      class="mt-4 text-[44px] leading-[1.1] font-medium tracking-[-0.03em] text-balance text-text-primary md:mt-5 md:text-[72px] md:leading-[82px]"
    >
      <span class="text-gradient-heading">Senior talent,</span>
      <br /> sized to the role.
    </h1>
    <p class="mt-6 text-[17px] leading-7 text-text-secondary md:text-[20px] md:leading-8">
      Senior specialists from across Latin America, on your clock and within
      your budget. The rate follows the role you need, starting costs nothing,
      and you see the terms in writing before anything begins.
    </p>
    <form class="relative mt-8 w-full">
      <label class="block">
        <span class="sr-only">Describe the role you need</span>
        <input
          type="text"
          placeholder="e.g. a senior RAG engineer, US-hours overlap"
          class="h-[60px] w-full rounded-full border-[0.75px] border-indigo-500/[0.32] bg-background-raised pr-[64px] pl-[26px] text-sm text-ellipsis text-text-primary shadow-[0_0_0_0.75px_rgb(110_123_255/0.06)] placeholder:text-text-tertiary focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none"
          value=""
        />
      </label>
      <button
        type="submit"
        aria-label="Describe your role"
        class="absolute inset-y-2 right-2 inline-flex w-11 items-center justify-center rounded-full bg-background-inverted text-text-inverse-primary shadow-dark-btn transition duration-120 ease-standard hover:bg-background-inverted-hover focus-visible:shadow-ring focus-visible:outline-none active:translate-y-px motion-reduce:transition-none"
      >
        <svg aria-hidden="true" class="size-4" viewBox="0 0 10 8" fill="none">
          <path
            d="M6 0 5.3.7l2.8 2.8H0v1h8.1L5.3 7.3l.7.7L10 4 6 0Z"
            fill="currentColor"
          />
        </svg>
      </button>
    </form>
  </div>
</section>
