---
---

<div data-reveal="out">
  <section class="relative overflow-hidden px-6 bg-background-base pt-24 pb-20 lg:pt-56 lg:pb-44">
    <div class="relative z-[1] mx-auto flex w-full max-w-[1080px] flex-col items-center text-center">
      <h2 class="w-full text-[40px] leading-[1.2] font-medium tracking-[-0.04em] text-text-primary lg:text-[54px]">
        <span class="block">Tell us what </span>{" "}
        <span class="text-gradient-heading block">your team needs.</span>
      </h2>
      <p class="mt-6 max-w-[680px] text-base leading-6 text-balance lg:mt-[34px] lg:text-[19px] lg:leading-[29px] text-text-secondary">
        One sentence is enough. We'll take it from there and introduce the
        specialists who fit. Nothing is published and no specialist is contacted
        until we review the role with you.
      </p>
      <form class="relative w-full max-w-[680px] mt-8 lg:mt-[31px]">
        <input
          type="text"
          placeholder="Describe your role, e.g. a senior RAG engineer with US-hours overlap"
          aria-label="Describe your role"
          class="h-[60px] w-full rounded-full border-[0.75px] border-indigo-500/[0.32] bg-white/[0.92] pr-[26px] pl-[26px] text-sm text-text-primary shadow-[0_0_0_0.75px_rgba(110,123,255,0.06)] placeholder:text-text-tertiary transition-colors duration-150 hover:border-indigo-500/50 focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none sm:pr-[168px] max-sm:pr-[64px] max-sm:text-ellipsis"
          value=""
        />
        <div class="mt-3 flex sm:absolute sm:inset-y-2 sm:right-2.5 sm:mt-0 max-sm:absolute max-sm:inset-y-2 max-sm:right-2 max-sm:mt-0">
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold w-full gap-4 border border-slate-800 sm:h-full sm:w-auto sm:pr-6 max-sm:h-full max-sm:w-11 max-sm:px-0"
          >
            <span class="max-sm:sr-only">Find Talent</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
      <div class="mt-8 flex max-w-[800px] flex-wrap justify-center gap-x-[11px] gap-y-[9.5px] lg:mt-[38.5px]">
        <button
          type="button"
          class="flex min-h-11 items-center leading-none transition-colors duration-120 ease-standard focus-visible:shadow-ring focus-visible:outline-none h-[38px] rounded-full bg-slate-100 px-[20px] text-[14px] font-medium tracking-[-0.02em] text-text-primary hover:bg-slate-200 sm:any-pointer-fine:min-h-[38px]"
        >
          Senior backend engineer
        </button>
        <button
          type="button"
          class="flex min-h-11 items-center leading-none transition-colors duration-120 ease-standard focus-visible:shadow-ring focus-visible:outline-none h-[38px] rounded-full bg-slate-100 px-[20px] text-[14px] font-medium tracking-[-0.02em] text-text-primary hover:bg-slate-200 sm:any-pointer-fine:min-h-[38px]"
        >
          DevOps &amp; cloud
        </button>
        <button
          type="button"
          class="flex min-h-11 items-center leading-none transition-colors duration-120 ease-standard focus-visible:shadow-ring focus-visible:outline-none h-[38px] rounded-full bg-slate-100 px-[20px] text-[14px] font-medium tracking-[-0.02em] text-text-primary hover:bg-slate-200 sm:any-pointer-fine:min-h-[38px] max-sm:hidden"
        >
          Product designer
        </button>
        <button
          type="button"
          class="flex min-h-11 items-center leading-none transition-colors duration-120 ease-standard focus-visible:shadow-ring focus-visible:outline-none h-[38px] rounded-full bg-slate-100 px-[20px] text-[14px] font-medium tracking-[-0.02em] text-text-primary hover:bg-slate-200 sm:any-pointer-fine:min-h-[38px]"
        >
          Data engineer
        </button>
        <button
          type="button"
          class="flex min-h-11 items-center leading-none transition-colors duration-120 ease-standard focus-visible:shadow-ring focus-visible:outline-none h-[38px] rounded-full bg-slate-100 px-[20px] text-[14px] font-medium tracking-[-0.02em] text-text-primary hover:bg-slate-200 sm:any-pointer-fine:min-h-[38px]"
        >
          Full-stack squad
        </button>
      </div>
    </div>
  </section>
</div>
