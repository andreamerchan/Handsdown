---
---

<section class="px-6 pt-16 pb-12 md:pt-[84px] md:pb-20">
  <div class="mx-auto flex max-w-[880px] flex-col items-center text-center">
    <p class="www-hero-settle text-gradient-heading text-[12px] leading-5 font-medium tracking-[0.15em] uppercase md:text-[14px]">
      Vetted tech talent across Latin America
    </p>
    <h1 class="mt-4 max-w-[640px] text-[44px] leading-[1.08] font-medium tracking-[-0.03em] text-balance text-text-primary md:mt-5 md:text-[72px] md:leading-[82px]">
      <span>
        <span class="www-hero-word" style="--i:0">
          From
        </span>
      </span>
      <span>
        {" "}
        <span class="www-hero-word" style="--i:1">
          first
        </span>
      </span>
      <span>
        {" "}
        <span class="www-hero-word" style="--i:2">
          message
        </span>
      </span>{" "}
      <br />
      <span class="www-hero-focus text-gradient-heading" style="--i:3">
        to embedded Engineer.
      </span>
    </h1>
    <p class="mt-6 max-w-[660px] text-[16px] leading-7 text-text-secondary md:text-[20px] md:leading-8">
      Find quality-assured talent you can rely on: vetted engineers across
      backend, frontend, fullstack, and mobile.
    </p>
    <form class="www-ask-glow relative mt-10 w-full rounded-full md:mt-12">
      <input
        type="text"
        aria-label="Describe the role you need"
        placeholder="e.g. a senior RAG engineer, US-hours overlap"
        class="h-[60px] w-full rounded-full border-[0.75px] border-indigo-500/[0.32] bg-white/[0.92] pr-[64px] pl-[26px] text-sm text-ellipsis text-text-primary shadow-[0_0_0_0.75px_rgb(110_123_255/0.06)] placeholder:text-text-tertiary focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none sm:pr-[170px]"
        value=""
      />
      <button
        type="submit"
        aria-label="Find Talent"
        class="www-sheen absolute inset-y-2 right-2 inline-flex w-11 items-center justify-center gap-3 rounded-full bg-background-inverted text-sm font-medium text-text-inverse-primary shadow-dark-btn transition duration-120 ease-standard hover:bg-background-inverted-hover focus-visible:shadow-ring focus-visible:outline-none active:translate-y-px motion-reduce:transition-none sm:w-auto sm:px-5"
      >
        <span aria-hidden="true" class="max-sm:hidden">
          Find Talent
        </span>
        <svg
          aria-hidden="true"
          class="size-4 sm:size-3"
          viewBox="0 0 10 8"
          fill="none"
        >
          <path
            d="M6 0 5.3.7l2.8 2.8H0v1h8.1L5.3 7.3l.7.7L10 4 6 0Z"
            fill="currentColor"
          />
        </svg>
      </button>
    </form>
  </div>
</section>
