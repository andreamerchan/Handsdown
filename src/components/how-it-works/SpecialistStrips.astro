---
---

<section
  aria-label="What every specialist comes with"
  data-layout="unmeasured"
  data-open="0"
  class="www-strips bg-background-inverted"
>
  <div class="www-strips-track">
    <div class="www-strips-stage">
      <ul
        class="www-strips-row"
        style="--strips-cols:0.5437fr 0.2281fr 0.2281fr"
      >
        <li
          data-strip="senior"
          data-open="true"
          class="www-strip relative overflow-hidden"
        >
          <img
            src="/brand/specialist-strips/orange-800.jpg"
            srcset="/brand/specialist-strips/orange-800.jpg 800w, /brand/specialist-strips/orange-1600.jpg 1600w"
            sizes="(min-width: 768px) 55vw, 100vw"
            alt="A smiling specialist in an orange shirt and glasses."
            width="1600"
            height="1497"
            loading="lazy"
            decoding="async"
            class="www-strip-photo absolute inset-0 size-full object-cover"
            style="object-position:48% 30%"
          />
          <dl class="www-strip-caption absolute inset-x-0 bottom-0 flex items-center justify-center bg-background-inverted/55 px-4">
            <div class="www-strip-words flex flex-col items-center gap-3.5 text-center">
              <dt class="text-[40px] leading-[34.5px] font-semibold tracking-[-0.04em] whitespace-nowrap text-text-inverse-primary md:text-[52px]">
                Senior
              </dt>
              <dd class="max-w-[220px] text-[14px] leading-[1.2] tracking-[-0.02em] text-text-inverse-secondary md:text-[16px]">
                specialists only
              </dd>
            </div>
          </dl>
        </li>
        <li data-strip="hours" class="www-strip relative overflow-hidden">
          <img
            src="/brand/specialist-strips/developer-800.jpg"
            srcset="/brand/specialist-strips/developer-800.jpg 800w, /brand/specialist-strips/developer-1600.jpg 1600w"
            sizes="(min-width: 768px) 55vw, 100vw"
            alt="A software developer at his desk, arms crossed, code on the screens behind him."
            width="1600"
            height="1497"
            loading="lazy"
            decoding="async"
            class="www-strip-photo absolute inset-0 size-full object-cover"
            style="object-position:58% 30%"
          />
          <dl class="www-strip-caption absolute inset-x-0 bottom-0 flex items-center justify-center bg-background-inverted/55 px-4">
            <div class="www-strip-words flex flex-col items-center gap-3.5 text-center">
              <dt class="text-[40px] leading-[34.5px] font-semibold tracking-[-0.04em] whitespace-nowrap text-text-inverse-primary md:text-[52px]">
                US hours
              </dt>
              <dd class="max-w-[220px] text-[14px] leading-[1.2] tracking-[-0.02em] text-text-inverse-secondary md:text-[16px]">
                real-time overlap from Latin America
              </dd>
            </div>
          </dl>
        </li>
        <li data-strip="checks" class="www-strip relative overflow-hidden">
          <img
            src="/brand/specialist-strips/glasses-800.jpg"
            srcset="/brand/specialist-strips/glasses-800.jpg 800w, /brand/specialist-strips/glasses-1600.jpg 1600w"
            sizes="(min-width: 768px) 55vw, 100vw"
            alt="A specialist in glasses and a navy sweater in a brick-walled office."
            width="1600"
            height="1497"
            loading="lazy"
            decoding="async"
            class="www-strip-photo absolute inset-0 size-full object-cover"
            style="object-position:65% 30%"
          />
          <dl class="www-strip-caption absolute inset-x-0 bottom-0 flex items-center justify-center bg-background-inverted/55 px-4">
            <div class="www-strip-words flex flex-col items-center gap-3.5 text-center">
              <dt class="text-[40px] leading-[34.5px] font-semibold tracking-[-0.04em] whitespace-nowrap text-text-inverse-primary md:text-[52px]">
                5 checks
              </dt>
              <dd class="max-w-[220px] text-[14px] leading-[1.2] tracking-[-0.02em] text-text-inverse-secondary md:text-[16px]">
                on every specialist
              </dd>
            </div>
          </dl>
        </li>
      </ul>
    </div>
  </div>
</section>
