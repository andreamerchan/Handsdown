---
---

<section
  id="how-it-works"
  aria-labelledby="how-we-work-title"
  data-layout="unmeasured"
  data-heading="quiet"
  class="www-hww"
>
  <div class="sr-only">
    <p class="font-mono text-[13.5px] leading-none tracking-[0.26em] text-text-accent uppercase">
      How we work
    </p>
    <h2
      id="how-we-work-title"
      class="text-[clamp(40px,4.2vw,56px)] leading-[1.14] font-medium tracking-[-0.036em] text-balance text-text-primary"
    >
      <span class="block">Less hiring.</span>{" "}
      <span class="block text-gradient-heading">More building.</span>
    </h2>
  </div>
  <div data-hww-track="true" class="www-hww-track">
    <div data-hww-stage="true" class="www-hww-stage">
      <div class="www-hww-rail">
        <ol aria-label="Steps" class="www-hww-nodes">
          <li aria-hidden="true" class="www-hww-fill"></li>
          <li data-on="true" data-current="true" class="www-hww-node">
            <button type="button" aria-current="step">
              <span class="www-hww-node-n">01</span>
              <span class="www-hww-node-t">Describe</span>
            </button>
          </li>
          <li class="www-hww-node">
            <button type="button">
              <span class="www-hww-node-n">02</span>
              <span class="www-hww-node-t">Align</span>
            </button>
          </li>
          <li class="www-hww-node">
            <button type="button">
              <span class="www-hww-node-n">03</span>
              <span class="www-hww-node-t">Match</span>
            </button>
          </li>
          <li class="www-hww-node">
            <button type="button">
              <span class="www-hww-node-n">04</span>
              <span class="www-hww-node-t">Hire</span>
            </button>
          </li>
        </ol>
      </div>
      <div class="www-hww-steps">
        <article data-step="describe" class="www-hww-step">
          <div class="www-hww-text">
            <p class="text-base leading-none tracking-[0.2em] text-text-tertiary uppercase">
              Step 1
            </p>
            <h3 class="mt-4 text-[clamp(30px,3.5vw,48px)] leading-[1.28] font-medium tracking-[-0.036em] text-balance text-text-primary">
              <span class="block text-gradient-heading">
                Describe the role.{" "}
              </span>
              <span class="block">We turn it into a </span>
              <span class="block">science-backed spec.</span>
            </h3>
            <p class="mt-3.5 max-w-[390px] text-base leading-[1.42] text-text-tertiary">
              The same questions and the same scale for everyone, so you compare
              people fairly and see the evidence behind every score.
            </p>
            <button
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-6"
            >
              Describe your role
            </button>
          </div>
          <div class="www-hww-spec" aria-hidden="true">
            <p class="www-hww-bubble">
              “We need a senior data scientist for machine learning work, on US
              hours.”
            </p>
            <span class="www-hww-link"></span>
            <div class="www-hww-card relative w-full overflow-hidden px-4 pt-3.5 pb-2.5">
              <span class="www-hww-scan"></span>
              <div class="flex items-center justify-between border-b border-border-default pb-3">
                <b class="text-sm font-semibold text-text-primary">
                  Your role spec
                </b>
                <span class="rounded-full bg-background-brand-subtle px-2.5 text-[11px] leading-[22px] font-semibold text-text-accent">
                  Free
                </span>
              </div>
              <dl>
                <div
                  class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                  style="--i:0"
                >
                  <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                    Role
                  </dt>
                  <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                    Senior Data Scientist
                  </dd>
                  <dd class="justify-self-end">
                    <span class="www-hww-badge">
                      <span
                        class="www-hww-badge-wait"
                        aria-hidden="true"
                      ></span>
                      <span class="www-hww-badge-done">
                        <svg
                          viewBox="0 0 10 10"
                          aria-hidden="true"
                          class="size-2.5"
                        >
                          <path
                            d="M1.8 5.3 4 7.4 8.2 2.8"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Clear
                      </span>
                    </span>
                  </dd>
                </div>
                <div
                  class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                  style="--i:1"
                >
                  <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                    Skills
                  </dt>
                  <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                    Python · Machine Learning
                  </dd>
                  <dd class="justify-self-end">
                    <span class="www-hww-badge">
                      <span
                        class="www-hww-badge-wait"
                        aria-hidden="true"
                      ></span>
                      <span class="www-hww-badge-done">
                        <svg
                          viewBox="0 0 10 10"
                          aria-hidden="true"
                          class="size-2.5"
                        >
                          <path
                            d="M1.8 5.3 4 7.4 8.2 2.8"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Weighted
                      </span>
                    </span>
                  </dd>
                </div>
                <div
                  class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                  style="--i:2"
                >
                  <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                    Hours
                  </dt>
                  <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                    US overlap
                  </dd>
                  <dd class="justify-self-end">
                    <span class="www-hww-badge">
                      <span
                        class="www-hww-badge-wait"
                        aria-hidden="true"
                      ></span>
                      <span class="www-hww-badge-done">
                        <svg
                          viewBox="0 0 10 10"
                          aria-hidden="true"
                          class="size-2.5"
                        >
                          <path
                            d="M1.8 5.3 4 7.4 8.2 2.8"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Confirmed
                      </span>
                    </span>
                  </dd>
                </div>
                <div
                  class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                  style="--i:3"
                >
                  <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                    Tested by
                  </dt>
                  <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                    Work sample · Structured interview
                  </dd>
                  <dd class="justify-self-end">
                    <span class="www-hww-badge">
                      <span
                        class="www-hww-badge-wait"
                        aria-hidden="true"
                      ></span>
                      <span class="www-hww-badge-done">
                        <svg
                          viewBox="0 0 10 10"
                          aria-hidden="true"
                          class="size-2.5"
                        >
                          <path
                            d="M1.8 5.3 4 7.4 8.2 2.8"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Proven
                      </span>
                    </span>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </article>
        <article
          data-step="search"
          data-mode="unmeasured"
          class="www-hww-search"
        >
          <div class="www-hww-search-pin">
            <div class="www-hww-search-stage">
              <canvas
                aria-hidden="true"
                class="absolute inset-0 block size-full"
              ></canvas>
              <div aria-hidden="true" class="www-hww-map">
                <div
                  data-candidate="true"
                  data-x="0.398"
                  data-y="0.151"
                  class="www-hww-cand"
                  style="left:39.800000000000004%;top:15.1%"
                >
                  <span class="www-hww-cand-avatar">LR</span>
                  <small>MX</small>
                </div>
                <div
                  data-candidate="true"
                  data-x="0.596"
                  data-y="0.275"
                  class="www-hww-cand"
                  style="left:59.599999999999994%;top:27.500000000000004%"
                >
                  <span class="www-hww-cand-avatar">JP</span>
                  <small>CO</small>
                </div>
                <div
                  data-candidate="true"
                  data-x="0.572"
                  data-y="0.42"
                  class="www-hww-cand"
                  style="left:57.199999999999996%;top:42%"
                >
                  <span class="www-hww-cand-avatar">RG</span>
                  <small>PE</small>
                </div>
                <div
                  data-candidate="true"
                  data-x="0.615"
                  data-y="0.566"
                  class="www-hww-cand"
                  style="left:61.5%;top:56.599999999999994%"
                >
                  <span class="www-hww-cand-avatar">VM</span>
                  <small>CL</small>
                </div>
                <div
                  data-candidate="true"
                  data-x="0.726"
                  data-y="0.618"
                  class="www-hww-cand"
                  style="left:72.6%;top:61.8%"
                >
                  <span class="www-hww-cand-avatar">NF</span>
                  <small>AR</small>
                </div>
                <div
                  data-candidate="true"
                  data-match="true"
                  data-x="0.811"
                  data-y="0.522"
                  class="www-hww-cand"
                  style="left:81.10000000000001%;top:52.2%"
                >
                  <span class="www-hww-cand-avatar">E</span>
                  <small>BR</small>
                </div>
                <div class="www-hww-match">
                  <span class="grid size-10 place-items-center rounded-full bg-background-inverted text-[13px] font-medium text-text-inverse-primary">
                    E
                  </span>
                  <span class="min-w-0">
                    <b class="block text-base leading-[1.2] font-semibold text-text-primary">
                      Edson
                    </b>
                    <span class="mt-1 block truncate text-sm leading-[1.2] text-text-tertiary">
                      Senior Data Scientist · São Paulo
                    </span>
                  </span>
                  <span class="rounded-full bg-background-success-subtle px-2.5 text-[12.5px] leading-[26px] font-semibold text-text-success">
                    Matched
                  </span>
                </div>
              </div>
              <div aria-hidden="true" class="www-hww-search-progress">
                <i></i>
              </div>
            </div>
            <div class="www-hww-search-grid">
              <div class="www-hww-text">
                <p class="text-base leading-none tracking-[0.2em] text-text-tertiary uppercase">
                  Step 2
                </p>
                <h3 class="mt-4 text-[clamp(30px,3.5vw,48px)] leading-[1.28] font-medium tracking-[-0.036em] text-balance text-text-primary">
                  <span class="block">We search across </span>
                  <span class="block text-gradient-heading">
                    Latin America{" "}
                  </span>
                  <span class="block">for your role.</span>
                </h3>
                <p class="mt-3.5 max-w-[390px] text-base leading-[1.42] text-text-tertiary">
                  Senior specialists from Mexico to Argentina, matched against
                  your spec and working in real time with your team.
                </p>
              </div>
              <div aria-hidden="true" class="www-hww-search-ghost"></div>
            </div>
          </div>
        </article>
        <article data-step="checks" class="www-hww-step">
          <div class="www-hww-text">
            <p class="text-base leading-none tracking-[0.2em] text-text-tertiary uppercase">
              Step 3
            </p>
            <h3 class="mt-4 text-[clamp(30px,3.5vw,48px)] leading-[1.28] font-medium tracking-[-0.036em] text-balance text-text-primary">
              <span class="block">Every candidate goes </span>
              <span class="block text-gradient-heading">
                through five checks.
              </span>
            </h3>
            <p class="mt-3.5 max-w-[390px] text-base leading-[1.42] text-text-tertiary">
              The same questions and the same scale for everyone, so you compare
              people fairly and see the evidence behind every score.
            </p>
            <button
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-6"
            >
              Describe your role
            </button>
          </div>
          <div class="www-hww-checks" aria-hidden="true">
            <div class="www-hww-card relative w-full overflow-hidden px-[15px] pt-4 pb-1.5">
              <span class="www-hww-bar"></span>
              <div class="flex items-center gap-2.5 border-b border-border-default pb-[18px]">
                <span class="grid size-[34px] place-items-center rounded-full bg-background-inverted text-[10.5px] font-medium text-text-inverse-primary">
                  E
                </span>
                <span>
                  <b class="block text-sm leading-[1.2] font-semibold text-text-primary">
                    Edson
                  </b>
                  <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                    Senior Data Scientist
                  </span>
                </span>
              </div>
              <ul>
                <li
                  class="www-hww-row flex min-h-[45px] items-center justify-between border-b border-border-default text-sm text-text-primary last:border-b-0"
                  style="--i:0"
                >
                  Structured interview
                  <span class="www-hww-badge">
                    <span class="www-hww-badge-wait" aria-hidden="true"></span>
                    <span class="www-hww-badge-done">
                      <svg
                        viewBox="0 0 10 10"
                        aria-hidden="true"
                        class="size-2.5"
                      >
                        <path
                          d="M1.8 5.3 4 7.4 8.2 2.8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      Rated
                    </span>
                  </span>
                </li>
                <li
                  class="www-hww-row flex min-h-[45px] items-center justify-between border-b border-border-default text-sm text-text-primary last:border-b-0"
                  style="--i:1"
                >
                  Work sample
                  <span class="www-hww-badge">
                    <span class="www-hww-badge-wait" aria-hidden="true"></span>
                    <span class="www-hww-badge-done">
                      <svg
                        viewBox="0 0 10 10"
                        aria-hidden="true"
                        class="size-2.5"
                      >
                        <path
                          d="M1.8 5.3 4 7.4 8.2 2.8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      Scored
                    </span>
                  </span>
                </li>
                <li
                  class="www-hww-row flex min-h-[45px] items-center justify-between border-b border-border-default text-sm text-text-primary last:border-b-0"
                  style="--i:2"
                >
                  Fit check
                  <span class="www-hww-badge">
                    <span class="www-hww-badge-wait" aria-hidden="true"></span>
                    <span class="www-hww-badge-done">
                      <svg
                        viewBox="0 0 10 10"
                        aria-hidden="true"
                        class="size-2.5"
                      >
                        <path
                          d="M1.8 5.3 4 7.4 8.2 2.8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      Compared
                    </span>
                  </span>
                </li>
                <li
                  class="www-hww-row flex min-h-[45px] items-center justify-between border-b border-border-default text-sm text-text-primary last:border-b-0"
                  style="--i:3"
                >
                  Consistency
                  <span class="www-hww-badge">
                    <span class="www-hww-badge-wait" aria-hidden="true"></span>
                    <span class="www-hww-badge-done">
                      <svg
                        viewBox="0 0 10 10"
                        aria-hidden="true"
                        class="size-2.5"
                      >
                        <path
                          d="M1.8 5.3 4 7.4 8.2 2.8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      Same scale
                    </span>
                  </span>
                </li>
                <li
                  class="www-hww-row flex min-h-[45px] items-center justify-between border-b border-border-default text-sm text-text-primary last:border-b-0"
                  style="--i:4"
                >
                  Scorecard
                  <span class="www-hww-badge">
                    <span class="www-hww-badge-wait" aria-hidden="true"></span>
                    <span class="www-hww-badge-done">
                      <svg
                        viewBox="0 0 10 10"
                        aria-hidden="true"
                        class="size-2.5"
                      >
                        <path
                          d="M1.8 5.3 4 7.4 8.2 2.8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      Evidence
                    </span>
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </article>
        <article data-step="shortlist" class="www-hww-step">
          <div class="www-hww-text">
            <p class="text-base leading-none tracking-[0.2em] text-text-tertiary uppercase">
              Step 4
            </p>
            <h3 class="mt-4 text-[clamp(30px,3.5vw,48px)] leading-[1.28] font-medium tracking-[-0.036em] text-balance text-text-primary">
              <span class="block text-gradient-heading">
                You meet a shortlist,{" "}
              </span>
              <span class="block">not a pile of CVs.</span>
            </h3>
            <p class="mt-3.5 max-w-[390px] text-base leading-[1.42] text-text-tertiary">
              Specialists who already said yes to your role, each scored against
              it. You interview, you decide, and we stay with you after they
              start.
            </p>
            <button
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-6"
            >
              Describe your role
            </button>
          </div>
          <div class="www-hww-shortlist" aria-hidden="true">
            <ul class="grid w-full gap-2.5">
              <li data-top="true" class="www-hww-cv" style="--i:0">
                <span class="www-hww-cv-avatar">E</span>
                <span>
                  <b class="block text-sm leading-[1.2] font-semibold">
                    Candidate A
                  </b>
                  <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                    Scored against your role
                  </span>
                </span>
                <span class="www-hww-bars">
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
              </li>
              <li class="www-hww-cv" style="--i:1">
                <span class="www-hww-cv-avatar">B</span>
                <span>
                  <b class="block text-sm leading-[1.2] font-semibold">
                    Candidate B
                  </b>
                  <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                    Scored against your role
                  </span>
                </span>
                <span class="www-hww-bars">
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
              </li>
              <li class="www-hww-cv" style="--i:2">
                <span class="www-hww-cv-avatar">C</span>
                <span>
                  <b class="block text-sm leading-[1.2] font-semibold">
                    Candidate C
                  </b>
                  <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                    Scored against your role
                  </span>
                </span>
                <span class="www-hww-bars">
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
              </li>
            </ul>
            <span class="www-hww-link www-hww-link-short"></span>
            <p class="www-hww-decide">You interview. You decide.</p>
            <ul class="mt-3 flex gap-1.5">
              <li class="www-hww-day" style="--i:0">
                Day 30
              </li>
              <li class="www-hww-day" style="--i:1">
                Day 60
              </li>
              <li class="www-hww-day" style="--i:2">
                Day 90
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
