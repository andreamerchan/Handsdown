---
// What the client has in hand after each step: four cards, the visual does the talking.
import { STEPS, SPEC_PARTS, ALIGN_GATES, ON_YOUR_TEAM } from "../../data/how-it-works";

const check = `<svg viewBox="0 0 10 10" aria-hidden="true" class="size-2.5"><path d="M1.8 5.3 4 7.4 8.2 2.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section id="what-you-get" aria-labelledby="hiw-get-title" class="px-6 py-24 md:py-32">
  <div class="mx-auto max-w-[1120px]">
    <div class="text-center">
      <p class="hiw-kicker">What you get</p>
      <h2
        id="hiw-get-title"
        class="mt-3 text-[clamp(32px,3.6vw,48px)] leading-[1.15] font-medium tracking-[-0.04em] text-balance text-text-primary"
      >
        Something concrete <span class="text-gradient-heading">at every step.</span>
      </h2>
    </div>

    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {STEPS.map((step, i) => (
        <li class="hiw-get" data-get data-step={step.id}>
          <div class="hiw-get-card h-full">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[11.5px] tracking-[0.1em] text-text-accent uppercase">
                {String(i + 1).padStart(2, "0")} · {step.label}
              </span>
              {step.id === "describe" && (
                <span class="rounded-full bg-background-brand-subtle px-2.5 text-[11px] leading-[22px] font-semibold text-text-accent">Free</span>
              )}
            </div>
            <b class="mt-2 block border-b border-border-default pb-3 text-[17px] leading-[1.25] font-semibold text-text-primary">
              {step.get}
            </b>

            {step.id === "describe" && (
              <ul class="hiw-parts" aria-label="What's in it">
                {SPEC_PARTS.map((part, k) => (
                  <li class="hiw-part" style={`--k:${k}`}>
                    <span class="hiw-tick" set:html={check}></span>
                    {part}
                  </li>
                ))}
              </ul>
            )}

            {step.id === "align" && (
              <ul class="hiw-parts" aria-label="Before the search starts">
                {ALIGN_GATES.map((g, k) => (
                  <li class="hiw-part" data-gate={g.state} style={`--k:${k}`}>
                    <span class="hiw-tick" set:html={g.state === "next" ? "→" : check}></span>
                    <span class="min-w-0 flex-1">{g.name}</span>
                    {g.state === "optional" && <span class="hiw-tag">Optional</span>}
                  </li>
                ))}
              </ul>
            )}

            {step.id === "match" && (
              <ul aria-label="Example scorecard">
                {["Skill 1", "Skill 2", "Skill 3", "Skill 4"].map((label, k) => (
                  <li class="hiw-score-row" style={`--k:${k};--v:${[0.86, 0.72, 0.8, 0.64][k]}`}>
                    <span class="text-[14px] text-text-secondary">{label}</span>
                    <span class="hiw-score-bar" aria-hidden="true"><i></i></span>
                  </li>
                ))}
              </ul>
            )}

            {step.id === "hire" && (
              <ul class="hiw-parts" aria-label="How they work with you">
                {ON_YOUR_TEAM.map((part, k) => (
                  <li class="hiw-part" style={`--k:${k}`}>
                    <span class="hiw-tick" set:html={check}></span>
                    {part}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
