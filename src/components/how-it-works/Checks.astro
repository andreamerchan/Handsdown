---
// Step 3 in depth: the five checks, what each one is and what it tells you.
import { CHECKS, STEPS } from "../../data/how-it-works";
const note = STEPS.find((s) => s.id === "match")?.note;
---

<section id="checks" aria-labelledby="hiw-checks-title" class="hiw-band bg-background-inverted px-6 py-24 md:py-32">
  <div class="mx-auto max-w-[1080px]">
    <div class="max-w-[620px]">
      <p class="hiw-kicker hiw-kicker-inverse">Step 3, up close</p>
      <h2
        id="hiw-checks-title"
        class="mt-3 text-[clamp(32px,3.6vw,48px)] leading-[1.15] font-medium tracking-[-0.04em] text-balance text-text-inverse-primary"
      >
        Five checks. <span class="text-gradient-heading">One scale for everyone.</span>
      </h2>
      <p class="mt-4 text-[17px] leading-[1.55] text-text-inverse-secondary">
        Every candidate answers the same questions and is rated on the same scale, so the scores mean the same thing for everyone.
      </p>
    </div>
    <ol class="hiw-check-table mt-12" data-seq>
      {CHECKS.map((c, k) => (
        <li class="hiw-check-row" style={`--k:${k}`}>
          <span class="hiw-check-n" aria-hidden="true">{String(k + 1).padStart(2, "0")}</span>
          <span>
            <b class="block text-[17px] leading-[1.3] font-semibold text-text-inverse-primary">{c.name}</b>
            <span class="mt-1 block font-mono text-[11.5px] leading-[1.5] tracking-[0.04em] text-text-inverse-tertiary uppercase">{c.how}</span>
          </span>
          <span class="text-[15.5px] leading-[1.5] text-text-inverse-secondary">{c.tells}</span>
        </li>
      ))}
    </ol>
    {note && <p class="hiw-note hiw-note-inverse mt-10 max-w-[620px]">{note}</p>}
  </div>
</section>
