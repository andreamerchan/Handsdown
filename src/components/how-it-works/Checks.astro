---
// Step 3 up close: the five checks as five tiles.
import { CHECKS } from "../../data/how-it-works";
---

<section id="checks" aria-labelledby="hiw-checks-title" class="bg-background-inverted px-6 py-24 md:py-32">
  <div class="mx-auto max-w-[1120px]">
    <div class="text-center">
      <p class="hiw-kicker hiw-kicker-inverse">Step 3, up close</p>
      <h2
        id="hiw-checks-title"
        class="mt-3 text-[clamp(32px,3.6vw,48px)] leading-[1.15] font-medium tracking-[-0.04em] text-balance text-text-inverse-primary"
      >
        Five checks. <span class="text-gradient-heading">One scale for everyone.</span>
      </h2>
    </div>
    <ol class="hiw-check-grid mt-12 md:mt-16" data-seq>
      {CHECKS.map((c, k) => (
        <li class="hiw-check-tile" style={`--k:${k}`}>
          <span class="hiw-check-n" aria-hidden="true">{String(k + 1).padStart(2, "0")}</span>
          <b class="mt-2 block text-[18px] lg:mt-6 leading-[1.25] font-semibold text-text-inverse-primary">{c.name}</b>
          <span class="mt-2 block text-[14.5px] leading-[1.45] text-text-inverse-secondary">{c.tells}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
