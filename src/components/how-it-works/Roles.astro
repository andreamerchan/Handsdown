---
// Who does what: one short line per side, per step.
import { STEPS } from "../../data/how-it-works";
---

<section id="who-does-what" aria-labelledby="hiw-roles-title" class="bg-background-raised px-6 py-24 md:py-32">
  <div class="mx-auto max-w-[880px]">
    <div class="text-center">
      <p class="hiw-kicker">Who does what</p>
      <h2
        id="hiw-roles-title"
        class="mt-3 text-[clamp(32px,3.6vw,48px)] leading-[1.15] font-medium tracking-[-0.04em] text-balance text-text-primary"
      >
        You decide. <span class="text-gradient-heading">We do the legwork.</span>
      </h2>
      <p class="mt-4 text-[17px] text-text-secondary">One hiring partner, from first call to after the start.</p>
    </div>

    <table class="hiw-roles mt-12">
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Step</span></th>
          <th scope="col" class="hiw-kicker">You</th>
          <th scope="col" class="hiw-kicker text-text-accent">We</th>
        </tr>
      </thead>
      <tbody>
        {STEPS.map((step) => (
          <tr>
            <th scope="row">{step.label}</th>
            <td>{step.you}</td>
            <td data-side="us">{step.we}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
