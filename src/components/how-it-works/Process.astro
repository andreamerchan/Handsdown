---
// The process, start to finish, told once: four steps (same labels as Home) and what
// happens after the start. Each chapter says what happens, how quality is checked, and
// the client's part. Static by design: no scroll-driven motion, just a chapter index that
// marks where you are (scripts/how-it-works/process-nav.ts).
import { STEPS, SPEC_PARTS, SPEC_QUALITY, CHECKS, AFTER_START } from "../../data/how-it-works";

const CHAPTERS = [...STEPS.map((s) => ({ id: s.id, label: s.label })), { id: "after-the-start", label: "After the start" }];
const n = (i: number) => String(i + 1).padStart(2, "0");
const check = `<svg viewBox="0 0 10 10" aria-hidden="true" class="size-2.5"><path d="M1.8 5.3 4 7.4 8.2 2.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const SCORECARD = [
  { skill: "Python", weight: "Must-have", score: "4.5" },
  { skill: "Machine learning", weight: "Must-have", score: "4.3" },
  { skill: "Communication", weight: "Weighted", score: "4.0" },
];
---

<section id="process" aria-labelledby="hiw-process-title" class="px-6 pt-10 pb-24 md:pt-16 md:pb-32">
  <div class="mx-auto max-w-[1120px]">
    <header class="max-w-[720px]">
      <p class="hiw-kicker">How it works</p>
      <h2
        id="hiw-process-title"
        class="mt-3 text-[clamp(32px,3.8vw,48px)] leading-[1.15] font-medium tracking-[-0.04em] text-balance text-text-primary"
      >
        How we make sure <span class="text-gradient-conversation">you get qualified talent.</span>
      </h2>
      <p class="mt-4 text-[18px] leading-[1.55] text-text-secondary">
        Four steps from your first message to a specialist on your team, and what we keep doing after they start.
      </p>
    </header>

    <div class="mt-12 gap-x-16 md:mt-16 lg:grid lg:grid-cols-[190px_minmax(0,1fr)]">
      <nav class="hiw-index" aria-label="Chapters">
        <ol>
          {CHAPTERS.map((c, i) => (
            <li>
              <a href={`#${c.id}`} data-chapter-link={c.id}>
                <span class="hiw-index-n">{i < 4 ? n(i) : "+"}</span>
                {c.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="hiw-chapters">
        {STEPS.map((step, i) => (
          <article id={step.id} class="hiw-chapter" aria-labelledby={`${step.id}-title`} data-chapter>
            <p class="hiw-kicker"><span class="text-text-accent">Step {i + 1}</span> · {step.label}</p>
            <h3 id={`${step.id}-title`} class="hiw-chapter-title">{step.title}</h3>
            <p class="hiw-chapter-intro">{step.intro}</p>

            {step.id === "describe" && (
              <div class="mt-8 grid gap-4 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
                <div class="hiw-doc">
                  <div class="flex items-center justify-between gap-3 border-b border-[#ebe4d6] pb-3">
                    <b class="text-[15px] font-semibold text-text-primary">What the spec defines</b>
                    <span class="rounded-full bg-background-brand-subtle px-2.5 text-[11px] leading-[22px] font-semibold text-text-accent">Free</span>
                  </div>
                  <dl class="mt-1">
                    {SPEC_PARTS.map((part) => (
                      <div class="hiw-doc-row">
                        <dt>{part.name}</dt>
                        <dd>{part.body}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div class="hiw-box">
                  <b class="text-[15px] font-semibold text-text-primary">Before it reaches you</b>
                  <ul class="mt-3 grid gap-2.5">
                    {SPEC_QUALITY.map((line) => (
                      <li class="hiw-tick-line"><span class="hiw-tick" set:html={check}></span>{line}</li>
                    ))}
                  </ul>
                  <p class="mt-4 border-t border-border-default pt-4 text-[14.5px] leading-[1.5] text-text-secondary">
                    It's yours to keep, whether or not you go ahead.
                  </p>
                </div>
              </div>
            )}

            {step.steps && (
              <ol class="hiw-numbered mt-8">
                {step.steps.map((line) => <li>{line}</li>)}
              </ol>
            )}

            {step.id === "match" && (
              <>
                <ol class="hiw-checks mt-8">
                  <li class="hiw-checks-head" aria-hidden="true">
                    <span></span><span>How it works</span><span>What it takes to pass</span>
                  </li>
                  {CHECKS.map((c, k) => (
                    <li class="hiw-check">
                      <span class="hiw-check-n">{n(k)}</span>
                      <div>
                        <b class="block text-[17px] leading-[1.3] font-semibold text-text-primary">{c.name}</b>
                        <p class="mt-1.5 text-[15px] leading-[1.55] text-text-secondary">{c.what}</p>
                      </div>
                      <p class="hiw-check-bar">{c.bar}</p>
                    </li>
                  ))}
                </ol>

                <div class="hiw-scorecard mt-8">
                  <div>
                    <b class="block text-[17px] font-semibold text-text-primary">What you see for each candidate</b>
                    <p class="mt-1.5 text-[15px] leading-[1.55] text-text-secondary">
                      A scorecard: a score for every skill in your spec, and the evidence behind each one. Not raw interview notes.
                    </p>
                  </div>
                  <div class="hiw-card" aria-label="Example scorecard">
                    <div class="flex items-center gap-2.5 border-b border-border-default pb-3">
                      <span class="grid size-[32px] place-items-center rounded-full bg-background-inverted text-[11px] font-medium text-text-inverse-primary" aria-hidden="true">A</span>
                      <span>
                        <b class="block text-sm leading-[1.2] font-semibold text-text-primary">Candidate A</b>
                        <span class="mt-0.5 block text-xs text-text-tertiary">Example</span>
                      </span>
                    </div>
                    <table class="hiw-score-table">
                      <tbody>
                        {SCORECARD.map((row) => (
                          <tr>
                            <th scope="row">{row.skill}<small>{row.weight}</small></th>
                            <td>{row.score}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <p class="border-t border-border-default pt-2.5 text-[12.5px] leading-[1.45] text-text-tertiary">
                      Evidence on every rating: interview notes and the work sample.
                    </p>
                  </div>
                </div>
              </>
            )}

            {step.yours && (
              <p class="hiw-yours"><b>Your part:</b> {step.yours}</p>
            )}
          </article>
        ))}

        <article id="after-the-start" class="hiw-chapter" aria-labelledby="after-the-start-title" data-chapter>
          <p class="hiw-kicker"><span class="text-text-accent">After the start</span></p>
          <h3 id="after-the-start-title" class="hiw-chapter-title">Hiring isn't where our job ends.</h3>
          <p class="hiw-chapter-intro">
            Once your specialist starts, we keep checking that they deliver what you hired them for.
          </p>
          <ul class="mt-8 grid gap-4 md:grid-cols-3">
            {AFTER_START.map((item) => (
              <li class="hiw-box">
                <b class="block text-[16px] leading-[1.3] font-semibold text-text-primary">{item.name}</b>
                <p class="mt-2 text-[15px] leading-[1.55] text-text-secondary">{item.body}</p>
              </li>
            ))}
          </ul>
          <p class="hiw-yours"><b>Your part:</b> Answer the check-ins. They take two minutes.</p>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/how-it-works/process-nav.ts";
</script>
