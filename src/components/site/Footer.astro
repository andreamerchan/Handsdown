---
// Site footer. "light" is the default; the home page uses "dark".
import Logo from "./Logo.astro";
import { footerColumns } from "../../data/site";

interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const dark = variant === "dark";
const linkClass = dark
  ? "inline-flex min-h-11 items-center py-1.5 text-[15px] transition-colors duration-120 sm:inline-block sm:min-h-0 text-text-inverse-primary hover:underline hover:underline-offset-4"
  : "inline-flex min-h-11 items-center py-1.5 text-[15px] transition-colors duration-120 sm:inline-block sm:min-h-0 font-semibold text-text-primary hover:text-text-brand";
---

<div data-reveal="out">
  <footer
    class={
      dark
        ? "bg-background-inverted text-text-inverse-primary"
        : "border-t border-border-default"
    }
  >
    <div
      class={
        dark
          ? "mx-auto w-full max-w-[1280px] px-4 sm:px-6 pt-20 pb-10"
          : "mx-auto w-full max-w-[1280px] px-4 sm:px-6 pt-14 pb-10"
      }
    >
      <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
        <div>
          <a
            href="/"
            aria-label="Handsdown"
            class={
              dark
                ? "max-lg:inline-flex max-lg:min-h-11 max-lg:items-center inline-block text-text-inverse-primary"
                : "max-lg:inline-flex max-lg:min-h-11 max-lg:items-center text-lg font-bold text-text-accent"
            }
          >
            {!dark && "Handsdown"}
            {dark && <Logo class="h-[22px] w-auto" />}
          </a>
          <p
            class={
              dark
                ? "mt-8 max-w-[320px] text-[15px] leading-6 text-slate-400"
                : "mt-3 max-w-[280px] text-sm leading-6 text-text-secondary"
            }
          >
            {dark
              ? "Engineering-focused staffing for teams that ship. Verified seniority, US hours, real-world proof."
              : "Senior tech talent from Latin America, working as part of your team."}
          </p>
        </div>
        <nav
          aria-label="Footer"
          class="col-span-full grid grid-cols-2 gap-10 sm:grid-cols-4 md:col-span-4"
        >
          {footerColumns.map((column) => (
            <div>
              <h3
                class={
                  dark
                    ? "eyebrow text-xs text-slate-400"
                    : "eyebrow text-xs text-text-secondary"
                }
              >
                {column.title}
              </h3>
              <ul class="mt-2.5 flex flex-col gap-1.5">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class={linkClass}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      {!dark && (
        <p class="mt-12 max-w-[760px] text-sm leading-6 text-text-secondary">
          Handsdown is an AI-first staff augmentation company. We add senior
          engineers, designers, data and product specialists from across Latin
          America to your team, working your hours. Tell us what you need, and
          we take care of finding, vetting and introducing the specialists who
          fit, then stay with you after they start.
        </p>
      )}
      {!dark && (
        <div class="mt-8 border-t border-border-default pt-6">
          <p class="text-sm text-text-secondary">
            © 2026 Handsdown. All rights reserved.
          </p>
        </div>
      )}
      {dark && (
        <div class="mt-16 text-center">
          <p class="text-[13px] text-slate-300">
            © 2026 Handsdown. All rights reserved.
          </p>
        </div>
      )}
    </div>
  </footer>
</div>
