---
// Closing prompt shared by /hire and the category pages.
const suggestions = [
  {
    label: "Senior backend engineer",
  },
  {
    label: "DevOps & cloud",
  },
  {
    label: "Product designer",
  },
  {
    label: "Data engineer",
  },
  {
    label: "Full-stack squad",
  },
];
---

<div data-reveal="out">
  <section
    id="describe-the-work"
    class="flex min-h-svh items-center px-6 py-24 lg:py-32 bg-background-inverted"
  >
    <div class="mx-auto flex w-full max-w-[1080px] flex-col items-center text-center">
      <p class="eyebrow text-[12px] text-text-inverse-accent">
        Not sure which role you need?
      </p>
      <h2 class="mt-6 text-[36px] leading-[1.1] font-medium tracking-[-0.02em] text-balance lg:text-[48px] text-text-inverse-primary">
        <span class="sm:hidden">
          Tell us what{" "}
          <span class="text-gradient-heading">your team needs.</span>
        </span>
        <span class="hidden sm:inline">
          Describe the work instead.
          <br />
          <span class="text-gradient-heading">
            We will help you figure out who fits.
          </span>
        </span>
      </h2>
      <p class="mt-5 max-w-[340px] text-[15px] leading-6 text-text-inverse-secondary sm:hidden">
        One sentence is enough. We'll take it from there and introduce the
        specialists who fit.
      </p>
      <form class="relative w-full max-w-[680px] mt-10">
        <input
          type="text"
          placeholder="Describe your role, e.g. a senior RAG engineer with US-hours overlap"
          aria-label="Describe the work"
          class="h-[60px] w-full rounded-full border-[0.75px] border-indigo-500/[0.32] bg-white/[0.92] pr-[26px] pl-[26px] text-sm text-text-primary shadow-[0_0_0_0.75px_rgba(110,123,255,0.06)] placeholder:text-text-tertiary transition-colors duration-150 hover:border-indigo-500/50 focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none sm:pr-[168px] max-sm:pr-[64px] max-sm:text-ellipsis"
          value=""
        />
        <div class="mt-3 flex sm:absolute sm:inset-y-2 sm:right-2.5 sm:mt-0 max-sm:absolute max-sm:inset-y-2 max-sm:right-2 max-sm:mt-0">
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold w-full gap-4 border border-slate-800 sm:h-full sm:w-auto sm:pr-6 max-sm:border-white max-sm:bg-white max-sm:text-text-primary max-sm:h-full max-sm:w-11 max-sm:px-0"
          >
            <span class="max-sm:sr-only">Match me</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
      <div class="mt-8 flex max-w-[800px] flex-wrap justify-center gap-x-[11px] gap-y-[9.5px]">
        {suggestions.map((item, i0) => (
          <button
            type="button"
            class="flex min-h-11 items-center leading-none transition-colors duration-120 ease-standard focus-visible:shadow-ring focus-visible:outline-none h-[29px] rounded-[6px] border-[0.75px] px-[19px] font-mono text-sm sm:any-pointer-fine:min-h-0 border-white/[0.12] bg-white/[0.05] text-white hover:border-white/[0.2] hover:bg-white/[0.09] max-sm:rounded-full max-sm:font-sans max-sm:text-[13px]"
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>
  </section>
</div>
