---
// Role prompt builder plus the skills grid with group tabs.
const { data } = Astro.props;
---

<section class="px-6 pb-20 max-lg:bg-background-neutral-subtle max-lg:pt-12 md:pb-24">
  <div class="mx-auto max-w-[1128px]">
    <section aria-labelledby="role-technologies">
      <h2
        id="role-technologies"
        class="text-[28px] leading-tight font-medium text-balance tracking-[-0.02em] text-text-primary md:text-[34px]"
      >
        <span class="sm:hidden">
          <span class="text-gradient-heading">Experienced</span>
          <br />
          {data.roleName}
        </span>
        <span class="max-sm:hidden">{data.skillsLabel}</span>
      </h2>
      <form class="mt-8 flex min-h-[60px] flex-wrap items-center gap-2 rounded-[30px] border-[0.75px] border-indigo-500/[0.32] bg-background-raised py-2 pr-2 pl-3 focus-within:border-border-focus focus-within:shadow-ring">
        <ul aria-label="Role titles" class="contents">
          {data.exampleRoles.map((item, i0) => (
            <li>
              <button
                type="button"
                aria-label={item.removeLabel}
                class="flex h-9 items-center gap-2 rounded-full bg-background-neutral-subtle px-3.5 text-[14px] text-text-primary transition-colors duration-120 hover:bg-background-neutral focus-visible:shadow-ring focus-visible:outline-none"
              >
                {item.label}
                <span aria-hidden="true" class="text-text-tertiary">
                  ×
                </span>
              </button>
            </li>
          ))}
        </ul>
        <ul aria-label="Chosen technologies" class="contents"></ul>
        <label class="min-w-[180px] grow">
          <span class="sr-only">Add anything else about the role</span>
          <input
            type="text"
            placeholder={data.promptPlaceholder}
            class="h-10 w-full bg-transparent px-2 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none any-pointer-coarse:h-11"
            value=""
          />
        </label>
        <button
          type="submit"
          aria-label="Open the chat with these technologies"
          class="ml-auto grid size-11 shrink-0 place-items-center rounded-full bg-background-inverted text-text-inverse-primary shadow-dark-btn transition duration-120 hover:-translate-y-px focus-visible:shadow-ring focus-visible:outline-none motion-reduce:transition-none"
        >
          <svg
            aria-hidden="true"
            width="12"
            height="10"
            viewBox="0 0 10 8"
            fill="none"
          >
            <path
              d="M6 0 5.3.7l2.8 2.8H0v1h8.1L5.3 7.3l.7.7L10 4 6 0Z"
              fill="currentColor"
            />
          </svg>
        </button>
      </form>
      <div
        role="tablist"
        aria-label="Filter technologies by type"
        class="mt-6 flex flex-wrap gap-2 max-sm:hidden"
      >
        {data.skillGroups.map((item, i0) => (
          <button
            type="button"
            role="tab"
            aria-selected={i0 === 0 ? "true" : "false"}
            aria-controls="hd-2"
            tabindex={i0 === 0 ? "0" : "-1"}
            class={
              i0 === 0
                ? "h-9 rounded-full px-4 text-[13px] font-medium transition-colors duration-120 focus-visible:shadow-ring focus-visible:outline-none any-pointer-coarse:h-11 bg-background-inverted text-text-inverse-primary"
                : "h-9 rounded-full px-4 text-[13px] font-medium transition-colors duration-120 focus-visible:shadow-ring focus-visible:outline-none any-pointer-coarse:h-11 text-text-secondary hover:bg-background-neutral-subtle hover:text-text-primary"
            }
          >
            {item.label}
          </button>
        ))}
      </div>
      <div
        id="hd-2"
        role="tabpanel"
        class="mt-5 border-t border-border-default pt-5"
      >
        <ul
          aria-label="Technologies"
          class="grid grid-cols-2 gap-3 md:grid-cols-4"
        >
          {data.skills.map((item, i0) => (
            <li>
              <button
                type="button"
                aria-pressed="false"
                class="flex h-full min-h-[64px] w-full items-start justify-between gap-3 rounded-[12px] border bg-background-raised px-4 py-3 text-left transition-colors duration-120 focus-visible:shadow-ring focus-visible:outline-none border-border-default hover:border-border-focus"
              >
                <span class="flex flex-col gap-1">
                  <span class="text-[15px] font-semibold text-text-primary">
                    {item.name}
                  </span>
                  <span class="font-mono text-[11px] tracking-[0.12em] text-text-tertiary uppercase lg:text-[10px]">
                    {item.group}
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-5 text-[15px] text-text-secondary">
        Working with something else? Tell us in the chat.
      </p>
    </section>
  </div>
</section>
