---
---

<div data-reveal="out">
  <section
    id="browse"
    class="scroll-mt-24 px-6 pt-4 pb-24 max-lg:bg-background-neutral-subtle md:pb-32 lg:pt-0"
  >
    <h2 class="sr-only">Hire by capability</h2>
    <div class="mx-auto max-w-[1080px] overflow-hidden rounded-[14px] border border-border-default bg-background-raised">
      <div class="-mr-px -mb-px grid sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex h-full flex-col bg-background-raised p-6 shadow-[inset_-1px_-1px_0_0_var(--color-border-default)] md:p-8">
          <h3 class="text-[22px] leading-7 font-semibold tracking-[-0.015em] text-text-primary">
            Engineering
          </h3>
          <p class="mt-3 grow text-[14px] leading-5 text-text-secondary">
            Frontend, backend, mobile, QA and cloud.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-8 w-full justify-center sm:w-auto sm:self-start sm:px-8"
            href="/hire/engineering"
          >
            Find an engineer <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex h-full flex-col bg-background-raised p-6 shadow-[inset_-1px_-1px_0_0_var(--color-border-default)] md:p-8">
          <h3 class="text-[22px] leading-7 font-semibold tracking-[-0.015em] text-text-primary">
            AI &amp; Data
          </h3>
          <p class="mt-3 grow text-[14px] leading-5 text-text-secondary">
            AI features, models, and analysis people act on.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-8 w-full justify-center sm:w-auto sm:self-start sm:px-8"
            href="/hire/ai-data"
          >
            Find an AI specialist <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex h-full flex-col bg-background-raised p-6 shadow-[inset_-1px_-1px_0_0_var(--color-border-default)] md:p-8">
          <h3 class="text-[22px] leading-7 font-semibold tracking-[-0.015em] text-text-primary">
            Data &amp; Analytics
          </h3>
          <p class="mt-3 grow text-[14px] leading-5 text-text-secondary">
            Engineers who make data trustworthy enough to decide on.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-8 w-full justify-center sm:w-auto sm:self-start sm:px-8"
            href="/hire/data-analytics"
          >
            Find a data specialist <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex h-full flex-col bg-background-raised p-6 shadow-[inset_-1px_-1px_0_0_var(--color-border-default)] md:p-8">
          <h3 class="text-[22px] leading-7 font-semibold tracking-[-0.015em] text-text-primary">
            Design
          </h3>
          <p class="mt-3 grow text-[14px] leading-5 text-text-secondary">
            Product, UX, UI, research and design systems.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-8 w-full justify-center sm:w-auto sm:self-start sm:px-8"
            href="/hire/design"
          >
            Find a designer <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex h-full flex-col bg-background-raised p-6 shadow-[inset_-1px_-1px_0_0_var(--color-border-default)] md:p-8">
          <h3 class="text-[22px] leading-7 font-semibold tracking-[-0.015em] text-text-primary">
            Product
          </h3>
          <p class="mt-3 grow text-[14px] leading-5 text-text-secondary">
            Scope, sequencing, shipping.
          </p>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-8 w-full justify-center sm:w-auto sm:self-start sm:px-8"
            href="/hire/product"
          >
            Find a product manager <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</div>
