---
// Role cards of a category, with the role brief panel.
const { data } = Astro.props;
---

<section
  id="specializations"
  class="scroll-mt-24 px-6 pb-24 max-lg:bg-background-neutral-subtle max-lg:pt-8 md:pb-32"
>
  <h2 class="sr-only">Which one do you need?</h2>
  <div class="mx-auto grid max-w-[1128px] gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    <div class="flex min-w-0 flex-col gap-6">
      <div class="">
        <form class="relative block w-full">
          <label class="block">
            <span class="sr-only">Describe the engineer or team you need</span>
            <input
              id="capability-brief"
              type="text"
              placeholder={data.promptPlaceholder}
              class="h-[52px] w-full rounded-full border-[0.75px] border-indigo-500/[0.32] bg-background-raised pr-[60px] pl-6 text-sm text-ellipsis text-text-primary shadow-[0_0_0_0.75px_rgb(110_123_255/0.06)] placeholder:text-text-tertiary focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none"
              value=""
            />
          </label>
          <button
            type="submit"
            aria-label="Describe your role"
            class="absolute top-1 right-1 grid size-11 place-items-center rounded-full bg-background-inverted text-text-inverse-primary shadow-dark-btn transition duration-120 hover:-translate-y-px focus-visible:shadow-ring focus-visible:outline-none motion-reduce:transition-none"
          >
            <svg
              aria-hidden="true"
              width="12"
              height="10"
              viewBox="0 0 10 8"
              fill="none"
            >
              <path
                d="M6 0 5.3.7l2.8 2.8H0v1h8.1L5.3 7.3l.7.7L10 4 6 0Z"
                fill="currentColor"
              />
            </svg>
          </button>
        </form>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {data.roles.map((item, i0) => (
          <li class="flex flex-col rounded-[14px] bg-background-neutral-subtle p-6 max-lg:bg-background-raised">
            <h3 class="text-[20px] leading-7 font-semibold tracking-[-0.015em] text-text-primary">
              {item.name}
            </h3>
            <p class="mt-2 grow text-[14px] leading-5 text-text-secondary">
              {item.summary}
            </p>
            <dl class="mt-4 flex flex-col gap-2 border-t border-border-default pt-4 text-[13px] leading-5 lg:hidden">
              {item.facts.map((item1, i1) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-text-tertiary">{item1.label}</dt>
                  <dd class="text-right text-text-primary">{item1.value}</dd>
                </div>
              ))}
            </dl>
            {item.cta != null && (
              <a
                class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-6 w-full justify-center"
                href={item.href}
              >
                {item.cta}
                <span aria-hidden="true">→</span>
              </a>
            )}
            {item.noPage != null && (
              <button
                type="button"
                class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-6 w-full justify-center"
              >
                Find a product manager <span aria-hidden="true">→</span>
              </button>
            )}
          </li>
        ))}
      </ul>
    </div>
    <div class="hidden lg:sticky lg:top-24 lg:block">
      <aside
        aria-label="Role brief"
        class="rounded-[16px] bg-background-inverted p-7 text-text-inverse-primary"
      >
        <p class="font-mono text-[11px] tracking-[0.14em] text-text-inverse-tertiary uppercase">
          {data.briefEyebrow}
        </p>
        <h3 class="mt-2 text-[22px] leading-7 font-semibold tracking-[-0.015em]">
          {data.briefTitle}
        </h3>
        {data.briefProfiles != null && (
          <div class="mt-6">
            <p class="font-mono text-[11px] tracking-[0.14em] text-text-inverse-tertiary uppercase">
              Profiles you can hire
            </p>
            <ul class="mt-3 flex flex-col gap-2.5">
              {data.briefProfiles.map((item, i0) => (
                <li class="flex items-center gap-2.5 text-[14px] text-text-inverse-secondary">
                  <span
                    aria-hidden="true"
                    class="size-1.5 rounded-full bg-indigo-400"
                  ></span>
                  {item.label}
                </li>
              ))}
            </ul>
          </div>
        )}
        <dl class="mt-6 flex flex-col gap-4 border-t border-border-on-inverse-default pt-5">
          <div>
            <dt class="font-mono text-[11px] tracking-[0.14em] text-text-inverse-tertiary uppercase">
              Working hours
            </dt>
            <dd class="mt-1 text-[14px] text-text-inverse-primary">
              US overlap, from Latin America
            </dd>
          </div>
          {data.briefShowPrice != null && (
            <div class="border-t border-border-on-inverse-default pt-4">
              <dt class="font-mono text-[11px] tracking-[0.14em] text-text-inverse-tertiary uppercase">
                Avg. price
              </dt>
              <dd class="mt-1 text-[14px] text-text-inverse-primary">
                Approx. $65–$140/hr
              </dd>
            </div>
          )}
        </dl>
        {data.briefCta != null && (
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 bg-background-neutral text-text-primary hover:bg-background-neutral-hover h-11 px-6 text-[15px] font-semibold mt-7 w-full justify-center"
            href={data.briefHref}
          >
            {data.briefCta}
            <span aria-hidden="true">→</span>
          </a>
        )}
        {data.briefNoPage != null && (
          <button
            type="button"
            class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 bg-background-neutral text-text-primary hover:bg-background-neutral-hover h-11 px-6 text-[15px] font-semibold mt-7 w-full justify-center"
          >
            Find a product manager <span aria-hidden="true">→</span>
          </button>
        )}
      </aside>
    </div>
  </div>
</section>
