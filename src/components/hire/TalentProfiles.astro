---
// Sample talent profile cards.
const { data } = Astro.props;
---

<section
  aria-labelledby="talent-profiles"
  class="px-6 pb-20 max-lg:bg-background-neutral-subtle md:pb-24"
>
  <div class="mx-auto max-w-[1128px]">
    <h2
      id="talent-profiles"
      class="text-[28px] leading-tight font-medium text-balance tracking-[-0.02em] text-text-primary md:text-[34px]"
    >
      {data.titleLead}
      <strong class="font-semibold">{data.titleAccent}</strong>
      {data.titleRest}
    </h2>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2">
      <li>
        <article
          aria-label="Camila"
          class="flex h-full flex-col rounded-[16px] border border-border-default bg-background-raised p-5"
        >
          <div class="flex gap-4">
            <img
              src="/brand/talent/data-scientist-750.jpg"
              alt="A smiling specialist at her desk, arms folded, with charts on the wall behind her."
              width="750"
              height="790"
              loading="lazy"
              decoding="async"
              class="size-[88px] shrink-0 rounded-[12px] object-cover object-top"
            />
            <div class="min-w-0 grow">
              <p class="mb-1 font-mono text-[10px] tracking-[0.12em] text-text-tertiary uppercase">
                Sample profile
              </p>
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-[17px] leading-6 font-semibold text-text-primary">
                  Camila
                </h3>
                <p class="shrink-0 text-[12px] text-text-secondary">
                  São Paulo, Brazil
                </p>
              </div>
              <p class="text-[13px] text-text-secondary">
                Senior Data Scientist
              </p>
              <p class="mt-2 flex items-center gap-1.5 text-[13px] text-text-secondary">
                <svg
                  aria-hidden="true"
                  width="12"
                  height="12"
                  viewBox="0 0 16 16"
                  fill="none"
                  class="shrink-0"
                >
                  <path
                    d="M8 1.75 2.75 3.75v4c0 3.25 2.25 5.5 5.25 6.5 3-1 5.25-3.25 5.25-6.5v-4L8 1.75Z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />
                </svg>
                Verified member since 2021
              </p>
              <p class="mt-1 flex items-center gap-1.5 text-[13px] text-text-secondary">
                <svg
                  aria-hidden="true"
                  width="12"
                  height="12"
                  viewBox="0 0 16 16"
                  fill="none"
                  class="shrink-0"
                >
                  <rect
                    x="1.75"
                    y="4.75"
                    width="12.5"
                    height="9"
                    rx="1.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <path
                    d="M5.75 4.75v-1.5a1 1 0 0 1 1-1h2.5a1 1 0 0 1 1 1v1.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                </svg>
                12 years of expertise
              </p>
            </div>
          </div>
          <p class="mt-5 font-mono text-[10px] tracking-[0.14em] text-text-tertiary uppercase">
            Specializes in
          </p>
          <ul
            aria-label="Specializes in"
            class="mt-2 flex grow flex-wrap content-start gap-2"
          >
            <li class="flex items-center gap-1 rounded-full bg-background-accent-subtle px-3 py-1 text-[12px] font-medium text-text-accent">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 16 16"
                fill="none"
                class="shrink-0"
              >
                <path
                  d="m3 8.5 3.25 3.25L13 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Tableau
            </li>
            <li class="rounded-full bg-background-neutral-faint px-3 py-1 text-[12px] text-text-secondary">
              Python
            </li>
            <li class="rounded-full bg-background-neutral-faint px-3 py-1 text-[12px] text-text-secondary">
              Machine Learning
            </li>
            <li class="rounded-full bg-background-neutral-faint px-3 py-1 text-[12px] text-text-secondary">
              Java
            </li>
            <li class="rounded-full bg-background-neutral-faint px-3 py-1 text-[12px] text-text-secondary">
              NoSQL
            </li>
          </ul>
          <button
            type="button"
            data-book-role="Data scientist"
            class="mt-5 flex h-11 w-full items-center justify-center gap-2 rounded-full bg-background-inverted text-[14px] font-semibold text-text-inverse-primary shadow-dark-btn transition duration-120 hover:-translate-y-px focus-visible:shadow-ring focus-visible:outline-none motion-reduce:transition-none"
          >
            Hire Camila or similar experts <span aria-hidden="true">→</span>
          </button>
        </article>
      </li>
    </ul>
  </div>
</section>

<script>
  import "../../scripts/hire/booking.ts";
</script>
