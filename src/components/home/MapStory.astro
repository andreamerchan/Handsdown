---
---

<div data-section-view="map-story">
  <section
    id="map-story"
    aria-labelledby="map-story-title"
    data-header-surface="20 22 29"
    class="www-tour"
  >
    <div class="stick" data-header-surface="20 22 29">
      <canvas data-why-canvas="true" aria-hidden="true"></canvas>
      <div class="why-layer" aria-hidden="true">
        <div class="ov card" id="ovTeam">
          <div class="dot"></div>
          <div class="cap">YOUR TEAM NEEDS</div>
          <div class="q">
            “We need a senior data scientist for machine learning work, on US
            hours.”
          </div>
          <div class="wrow">
            <span class="k">ROLE</span>
            <span class="v">Senior Data Scientist</span>
            <span class="ok">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
          </div>
          <div class="wrow">
            <span class="k">SKILLS</span>
            <span class="v">Python · Machine Learning</span>
            <span class="ok">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
          </div>
          <div class="wrow">
            <span class="k">HOURS</span>
            <span class="v">US overlap</span>
            <span class="ok">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
          </div>
        </div>
        <div class="ov tip" id="ovHours">
          <b>US hours</b>
          <span>
            Real-time overlap from
            <br />
            Latin America
          </span>
          <i>United States</i>
        </div>
        <div class="ov" id="ovLatam">
          LATIN AMERICA
        </div>
        <div class="ov tip" id="ovSenior">
          <b>Senior</b>
          <span>Specialists only · Fluent English</span>
          <i>Latin America</i>
        </div>
        <div class="ov card" id="ovProf">
          <img
            src="/brand/talent-cards/ai-data-750.jpg"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div>
            <b>
              Edson <span class="pill-g">Shortlisted</span>
            </b>
            <small>Senior Data Scientist · São Paulo</small>
            <div class="tg">
              <span>Python</span>
              <span>Machine Learning</span>
              <span>SQL</span>
            </div>
          </div>
        </div>
        <div class="ov card" id="ovChecks">
          <div class="ck2">
            <span class="c">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
            <div>
              <b>Skills screen</b>
              <small>Scored against your Role Spec</small>
            </div>
            <span class="s">4.5</span>
          </div>
          <div class="ck2">
            <span class="c">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
            <div>
              <b>Structured interview</b>
              <small>In English · same questions, fixed scale</small>
            </div>
            <span class="s">4.3</span>
          </div>
          <div class="ck2">
            <span class="c">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
            <div>
              <b>Work sample</b>
              <small>Real task, AI tools allowed</small>
            </div>
            <span class="s">4.5</span>
          </div>
          <div class="ck2">
            <span class="c">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
            <div>
              <b>Fit check</b>
              <small>Work style and goals vs. your team</small>
            </div>
            <span class="s">Strong</span>
          </div>
          <div class="ck2">
            <span class="c">
              <svg
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 6.3 5 8.8l4.5-5" />
              </svg>
            </span>
            <div>
              <b>Fairness check</b>
              <small>Scoring audited for bias</small>
            </div>
            <span class="s">Passed</span>
          </div>
        </div>
        <div class="ov tip" id="ovStay">
          <b>
            30 <em></em> 60 <em></em> 90
          </b>
          <span>
            Check-ins after they start.
            <br />
            Free replacement if it's not a fit.
          </span>
        </div>
        <div class="ov card" id="ovEdson">
          <b>
            Edson <span class="pill-g">Placed</span>
          </b>
          <small>Senior Data Scientist · São Paulo</small>
        </div>
      </div>
      <div class="why-text">
        <div class="why-count" id="whyCount" aria-hidden="true">
          01 / 05
        </div>
        <div class="frames">
          <div class="frame" data-beat="role">
            <h2 id="map-story-title">
              You bring
              <br />
              the role.
            </h2>
            <p>Describe it the way you'd tell a colleague.</p>
          </div>
          <div class="frame" data-beat="hours">
            <h2>
              Working
              <br />
              your hours.
            </h2>
            <p>
              In your time zone, as part of your team. Same standup, same
              afternoon.
            </p>
          </div>
          <div class="frame" data-beat="senior">
            <h2>
              Only senior
              <br />
              specialists.
            </h2>
            <p>
              Engineers, designers, data and product specialists from across
              Latin America.
            </p>
          </div>
          <div class="frame" data-beat="vetted">
            <h2>
              Vetted against
              <br />
              your role.
            </h2>
            <p>
              Skills, interview, work sample, fit and fairness. Before you meet
              anyone.
            </p>
          </div>
          <div class="frame" data-beat="stay">
            <h2>
              We stay after
              <br />
              they start.
            </h2>
            <p>
              Check-ins at day 30, 60 and 90. Not the right fit? We replace them
              at no cost.
            </p>
          </div>
        </div>
      </div>
      <div class="why-hint" id="whyHint" aria-hidden="true">
        SCROLL
      </div>
      <div class="why-prog" id="whyProg"></div>
    </div>
  </section>
</div>

<script>
  import "../../scripts/home-top/map-story.ts";
</script>
