---
---

<div data-section-view="team-photo">
  <section
    id="team-photo"
    aria-label="Matched specialists in a client team"
    class="www-team"
    data-cursor="idle"
    data-card="0"
    data-pointing="left"
    style="--card-left:25.2%;--card-top:59%;--zoom-x:43.6%"
  >
    <div class="www-team-heading">
      <h2>
        <span class="block">See the evidence</span>{" "}
        <span class="block text-gradient-heading">not just the résumé</span>
      </h2>
      <p>
        Every shortlisted specialist comes with a scorecard against your Role
        Spec, and notes on why they scored that way.
      </p>
    </div>
    <div class="www-team-frame">
      <img
        src="/brand/team-photo/team-1000.jpg"
        srcset="/brand/team-photo/team-1000.jpg 1000w, /brand/team-photo/team-2000.jpg 2000w"
        sizes="100vw"
        alt="A product team smiling together at the office"
        width="2000"
        height="1292"
        loading="lazy"
        decoding="async"
        class="www-team-photo"
      />
      <svg aria-hidden="true" viewBox="0 0 34 38" class="www-team-cursor">
        <path
          d="M4 3.5 30 18.6 17.6 21.3 11 34.2 4 3.5Z"
          fill="currentColor"
          stroke="white"
          stroke-width="2"
          stroke-linejoin="round"
        />
      </svg>
      <div aria-hidden="true" class="www-team-card">
        <div class="flex items-center justify-between gap-3">
          <b class="text-xl leading-none font-semibold tracking-[-0.01em] text-text-primary">
            Edson
          </b>
          <span class="h-[26px] rounded-full bg-background-inverted px-3 text-[12.5px] leading-[26px] font-medium text-text-inverse-primary tabular-nums">
            Score <span>98</span>%
          </span>
        </div>
        <span class="mt-3 block text-[15px] leading-none text-text-tertiary">
          Senior Data Scientist
        </span>
        <ul class="mt-[22px] flex flex-wrap gap-x-2.5 gap-y-2">
          <li class="h-[30px] rounded-full bg-background-neutral-subtle px-[13px] text-[13.5px] leading-[30px] text-text-secondary">
            Python
          </li>
          <li class="h-[30px] rounded-full bg-background-neutral-subtle px-[13px] text-[13.5px] leading-[30px] text-text-secondary">
            Machine Learning
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>

<script>
  import "../../scripts/home-bottom/team-photo.ts";
</script>
