---
---

<section aria-labelledby="hero-title" class="www-net-hero">
  <div class="www-net-stage">
    <canvas
      data-network-canvas="true"
      role="img"
      aria-label="Map: US teams connected with vetted talent across Latin America"
      class="www-net-canvas"
    ></canvas>
    <div class="www-net-story">
      <span class="www-net-tag">
        <i></i>The handsdown network
      </span>
      <div class="www-net-lines">
        <p class="hs-line">US teams need senior talent.</p>
        <p class="hs-line">
          We search across <em>Latin America.</em>
        </p>
        <p class="hs-line">
          Vetted talent joins <em>your team.</em>
        </p>
      </div>
    </div>
    <div class="hs-o" id="hsCo">
      <div class="www-net-chip" data-kind="team">
        <span class="www-net-ic">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M3 21h18M8 7h4M8 11h4M8 15h4"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <span>
          <b>Your team</b>
          <small>New York · hiring</small>
        </span>
      </div>
    </div>
    <div class="hs-o" id="hsT1">
      <div class="www-net-chip" data-kind="talent">
        <span class="www-net-ic">B</span>
        <span>
          <b>Backend Engineer</b>
          <small>
            Bogotá · <span class="text-text-success">✓ Vetted</span>
          </small>
        </span>
      </div>
    </div>
    <div class="hs-o" id="hsT2">
      <div class="www-net-chip" data-kind="talent">
        <span class="www-net-ic">D</span>
        <span>
          <b>Senior Data Scientist</b>
          <small>
            São Paulo · <span class="text-text-success">✓ Vetted</span>
          </small>
        </span>
      </div>
    </div>
    <div class="hs-o www-net-pin" id="hsPin">
      <div class="www-net-chip">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-violet-soft"
          aria-hidden="true"
        >
          <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        <span>
          <b>Latin America</b>
          <small>Vetted talent · US-hours overlap</small>
        </span>
      </div>
    </div>
  </div>
  <div class="www-net-words">
    <p class="www-hero-rise py-[7px] text-[14px] leading-[1.2] font-medium tracking-[0.09em] text-text-accent uppercase max-sm:text-[12px]">
      Vetted tech talent across Latin America
    </p>
    <h1
      id="hero-title"
      data-motion="focus-lines"
      class="mt-[12px] text-[42px] leading-[1.17] font-medium tracking-[-0.04em] text-text-primary sm:mt-[19px] sm:text-[58px] sm:leading-[68px]"
    >
      <span class="hd-focus-line" style="--i:0">Add the CTO</span> <br />
      <span class="hd-focus-line" style="--i:1">your CEO would have</span> <br />
      <span class="hd-focus-line text-gradient-conversation" style="--i:2">hired anyway.</span>
    </h1>
    <p
      class="www-hero-rise mt-[18px] max-w-[470px] text-[18px] leading-[1.42] tracking-[-0.02em] text-text-tertiary"
      style="animation-delay:780ms"
    >
      Senior engineers, designers and data specialists from Latin America,
      embedded in your team and working your hours. You interview. You decide.
    </p>
    <div class="www-hero-rise mt-[27px]" style="animation-delay:900ms">
      <form class="w-full">
        <div class="relative www-ask-glow">
          <div class="reticle w-full rounded-full h-14">
            <input
              type="text"
              placeholder="E.g. a senior RAG engineer, US-hours overlap"
              aria-label="Describe the role you're hiring for"
              role="combobox"
              aria-expanded="false"
              aria-controls="hd-2"
              aria-autocomplete="list"
              class="size-full rounded-full border-[0.75px] border-border-default bg-white/[0.92] pr-[60px] pl-5 text-ellipsis text-sm text-text-primary shadow-[0_0_0_0.75px_rgb(110_123_255/0.06)] placeholder:text-text-tertiary focus-visible:border-border-focus focus-visible:shadow-ring focus-visible:outline-none max-sm:pr-[60px]"
              value=""
            />
          </div>
          <button
            type="submit"
            class="www-sheen inline-flex items-center justify-center rounded-full border border-slate-800 bg-background-inverted text-sm text-text-inverse-primary shadow-dark-btn transition duration-120 ease-standard hover:bg-background-inverted-hover focus-visible:shadow-ring focus-visible:outline-none active:translate-y-px motion-reduce:transition-none absolute top-1.5 right-1 h-11 gap-3 font-medium tracking-[-0.02em] w-11 px-0"
          >
            <span class="sr-only">Find Talent</span>
            <svg
              aria-hidden="true"
              class="size-[11px]"
              width="10"
              height="8"
              viewBox="0 0 10 8"
              fill="none"
            >
              <path
                d="M6 0 5.3.7l2.8 2.8H0v1h8.1L5.3 7.3l.7.7L10 4 6 0Z"
                fill="currentColor"
              />
            </svg>
          </button>
        </div>
        <p aria-live="polite" class="sr-only"></p>
        <ul
          id="hd-2"
          role="listbox"
          aria-label="Suggested roles"
          class="mt-4 flex flex-wrap justify-center gap-2 hidden"
        ></ul>
      </form>
    </div>
  </div>
</section>

<script>
  import "../../scripts/home-top/network-globe.ts";
  import "../../scripts/home-top/prompt-placeholder.ts";
</script>
