---
---

<div data-section-view="two-ways">
  <section
    id="two-ways"
    aria-labelledby="two-ways-heading"
    class="py-20 lg:py-24"
  >
    <div class="mx-auto max-w-[810px] px-6 text-center">
      <div>
        <h2
          id="two-ways-heading"
          class="text-[36px] leading-[1.2] font-medium tracking-[-0.04em] text-balance text-text-primary md:text-[54px]"
        >
          <span class="block">Two ways</span>{" "}
          <span class="block text-gradient-conversation">to work with us</span>
        </h2>
      </div>
      <div>
        <p class="mx-auto mt-7 max-w-[770px] text-lg leading-[1.55] tracking-[-0.014em] text-text-secondary">
          Both start the same way: a free Role Spec and a vetted shortlist. The
          difference is who runs the day-to-day.
        </p>
      </div>
    </div>
    <ul class="mx-auto mt-12 grid max-w-[1440px] gap-8 px-6 lg:mt-[57px] lg:grid-cols-2 lg:gap-[89px] lg:px-[120px]">
      <li>
        <div class="h-full">
          <article
            data-way="specialist"
            class="flex h-full flex-col gap-5 border border-border-default bg-background-raised px-[31px] pt-0 pb-[27px] lg:pt-0"
          >
            <div class="relative -mx-[31px] aspect-[583/284] overflow-hidden bg-background-neutral-subtle">
              <img
                src="/brand/home/two-ways/specialist-1400.jpg"
                alt="A smiling engineer in glasses at his desk, code on the screen behind him"
                loading="lazy"
                decoding="async"
                class="absolute max-w-none"
                style="width:139.91%;height:191.1%;left:-21.89%;top:-29.84%"
              />
              <div class="hd-join" data-join="specialist" aria-hidden="true">
                <span class="hd-join-team">
                  <i></i><i></i><i></i><i></i><i class="hd-join-new" data-handsdown></i>
                </span>
                <span class="hd-join-label">You lead the work.</span>
              </div>
            </div>
            <p class="w-fit rounded-[15px] bg-background-accent-subtle px-2.5 py-1.5 text-[14px] leading-[1.2] font-medium tracking-[-0.02em] text-text-accent">
              Staff augmentation
            </p>
            <div class="flex flex-1 flex-col gap-3">
              <h3 class="text-[28px] leading-[1.1] font-bold tracking-[-0.014em] text-text-primary">
                Individual specialists
              </h3>
              <p class="text-base leading-[1.55] tracking-[-0.006em] text-text-secondary">
                Add one or more specialists to your team. They join your
                standups, your tools and your roadmap. You lead the work.
              </p>
              <p class="rounded-[12px] bg-background-accent-subtle/60 px-3 py-3.5 text-base leading-[1.55] tracking-[-0.006em] text-text-secondary">
                <strong class="font-bold text-text-primary">Best for:</strong>{" "}
                Teams with engineering leadership that need more hands or
                missing skill.
              </p>
              <ul class="flex flex-col gap-3">
                <li class="flex items-center gap-2 text-base leading-[1.55] tracking-[-0.006em] text-text-primary">
                  <img
                    src="/brand/home/two-ways/check.svg"
                    alt=""
                    width="20"
                    height="20"
                    class="size-5 shrink-0"
                  />
                  Full-time and dedicated to your team
                </li>
                <li class="flex items-center gap-2 text-base leading-[1.55] tracking-[-0.006em] text-text-primary">
                  <img
                    src="/brand/home/two-ways/check.svg"
                    alt=""
                    width="20"
                    height="20"
                    class="size-5 shrink-0"
                  />
                  Works in your stack, repo and Slack
                </li>
                <li class="flex items-center gap-2 text-base leading-[1.55] tracking-[-0.006em] text-text-primary">
                  <img
                    src="/brand/home/two-ways/check.svg"
                    alt=""
                    width="20"
                    height="20"
                    class="size-5 shrink-0"
                  />
                  Add or remove people as your roadmap changes
                </li>
              </ul>
            </div>
            <button
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold w-fit"
            >
              Add a specialist <span aria-hidden="true">→</span>
            </button>
          </article>
        </div>
      </li>
      <li>
        <div class="h-full">
          <article
            data-way="team"
            class="flex h-full flex-col gap-5 border border-border-default bg-background-raised px-[31px] pt-0 pb-[27px] lg:pt-0"
          >
            <div class="relative -mx-[31px] aspect-[583/284] overflow-hidden bg-background-neutral-subtle">
              <img
                src="/brand/home/two-ways/team-1400.jpg"
                alt="Four specialists standing together in an office, smiling"
                loading="lazy"
                decoding="async"
                class="absolute max-w-none"
                style="width:103.46%;height:138.45%;left:-2.15%;top:0%"
              />
              <div class="hd-join" data-join="team" aria-hidden="true">
                <span class="hd-join-team">
                  <i></i><i></i><i></i><i></i>
                  <span class="hd-join-pod"><i class="hd-join-lead" data-handsdown></i><i data-handsdown></i><i data-handsdown></i></span>
                </span>
                <span class="hd-join-label">We run delivery.</span>
              </div>
            </div>
            <p class="w-fit rounded-[15px] bg-background-accent-subtle px-2.5 py-1.5 text-[14px] leading-[1.2] font-medium tracking-[-0.02em] text-text-accent">
              Managed delivery
            </p>
            <div class="flex flex-1 flex-col gap-3">
              <h3 class="text-[28px] leading-[1.1] font-bold tracking-[-0.014em] text-text-primary">
                Embedded team
              </h3>
              <p class="text-base leading-[1.55] tracking-[-0.006em] text-text-secondary">
                A small cross-functional team with its own lead, accountable for
                a scope you define. We run delivery. You own the priorities.
              </p>
              <p class="rounded-[12px] bg-background-accent-subtle/60 px-3 py-3.5 text-base leading-[1.55] tracking-[-0.006em] text-text-secondary">
                <strong class="font-bold text-text-primary">Best for:</strong>{" "}
                founders without a tech lead, or a product line that needs its
                own team.
              </p>
              <ul class="flex flex-col gap-3">
                <li class="flex items-center gap-2 text-base leading-[1.55] tracking-[-0.006em] text-text-primary">
                  <img
                    src="/brand/home/two-ways/check.svg"
                    alt=""
                    width="20"
                    height="20"
                    class="size-5 shrink-0"
                  />
                  Tech lead included
                </li>
                <li class="flex items-center gap-2 text-base leading-[1.55] tracking-[-0.006em] text-text-primary">
                  <img
                    src="/brand/home/two-ways/check.svg"
                    alt=""
                    width="20"
                    height="20"
                    class="size-5 shrink-0"
                  />
                  Weekly demos and a written update
                </li>
                <li class="flex items-center gap-2 text-base leading-[1.55] tracking-[-0.006em] text-text-primary">
                  <img
                    src="/brand/home/two-ways/check.svg"
                    alt=""
                    width="20"
                    height="20"
                    class="size-5 shrink-0"
                  />
                  Accountable for outcomes, not hours
                </li>
              </ul>
            </div>
            <button
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold w-fit"
            >
              Build a team <span aria-hidden="true">→</span>
            </button>
          </article>
        </div>
      </li>
    </ul>
  </section>
</div>

<script>
  import "../../scripts/home-bottom/book-buttons.ts";
</script>
