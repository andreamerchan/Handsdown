---
// Two ways to work with us (specialists or an embedded team): two cards, built to fit
// one screen on desktop. The headline asks the visitor's question; no internal names.
// Photo strip, tag + name, one line, three checks, who it's best for, CTA.
// The join animation in each photo (.hd-join) is wired in src/motion/home.ts.
const WAYS = [
  {
    id: "specialist",
    tag: "Staff augmentation",
    name: "Individual specialists",
    line: "They join your standups, tools and roadmap. You lead the work.",
    checks: ["Full-time and dedicated to your team", "Works in your stack, repo and Slack", "Add or remove people as your roadmap changes"],
    bestFor: "Teams with an engineering lead.",
    cta: "Add a specialist",
    img: "/brand/home/two-ways/specialist-1400.jpg",
    alt: "A smiling engineer in glasses at his desk, code on the screen behind him",
    focus: "50% 38%",
    label: "You lead the work.",
  },
  {
    id: "team",
    tag: "Managed delivery",
    name: "Embedded team",
    line: "Its own lead, accountable for a scope you define.",
    checks: ["Tech lead included", "Weekly demos and a written update", "Accountable for outcomes, not hours"],
    bestFor: "Founders without a tech lead.",
    cta: "Build a team",
    img: "/brand/home/two-ways/team-1400.jpg",
    alt: "Four specialists standing together in an office, smiling",
    focus: "50% 30%",
    label: "We run delivery.",
  },
];
const btn =
  "inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-10 px-5 text-[14.5px] font-semibold shrink-0";
---

<div data-section-view="two-ways">
  <section id="two-ways" aria-labelledby="two-ways-heading" class="flex flex-col justify-center py-16 lg:min-h-[calc(100svh-74px)] lg:py-10">
    <div class="mx-auto max-w-[810px] px-6 text-center">
      <h2
        id="two-ways-heading"
        class="text-[34px] leading-[1.15] font-medium tracking-[-0.04em] text-balance text-text-primary md:text-[46px]"
      >
        More hands, <span class="block text-gradient-conversation md:inline">or a whole team?</span>
      </h2>
      <p class="mx-auto mt-3 text-[17px] leading-[1.5] tracking-[-0.014em] text-text-secondary">
        Add a specialist you lead, or a team that runs delivery for you. Same vetting either way.
      </p>
    </div>
    <ul class="mx-auto mt-9 grid w-full max-w-[1120px] gap-6 px-6 md:grid-cols-2 lg:mt-10 lg:gap-8">
      {WAYS.map((way) => (
        <li>
          <article data-way={way.id} class="flex h-full flex-col overflow-hidden rounded-[14px] border border-border-default bg-background-raised">
            <div class="relative aspect-[16/6] overflow-hidden [@media(min-width:768px)_and_(max-height:820px)]:aspect-[16/4.6] bg-background-neutral-subtle">
              <img
                src={way.img}
                alt={way.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 size-full object-cover"
                style={`object-position:${way.focus}`}
              />
              {way.id === "specialist" ? (
                <div class="hd-join" data-join="specialist" aria-hidden="true">
                  <span class="hd-join-team">
                    <i></i><i></i><i></i><i></i><i class="hd-join-new" data-handsdown></i>
                  </span>
                  <span class="hd-join-label">{way.label}</span>
                </div>
              ) : (
                <div class="hd-join" data-join="team" aria-hidden="true">
                  <span class="hd-join-team">
                    <i></i><i></i><i></i><i></i>
                    <span class="hd-join-pod"><i class="hd-join-lead" data-handsdown></i><i data-handsdown></i><i data-handsdown></i></span>
                  </span>
                  <span class="hd-join-label">{way.label}</span>
                </div>
              )}
            </div>
            <div class="flex flex-1 flex-col px-6 pt-5 pb-6">
              <p class="w-fit rounded-[15px] bg-background-accent-subtle px-2.5 py-1 text-[13px] leading-[1.3] font-medium tracking-[-0.02em] text-text-accent">
                {way.tag}
              </p>
              <h3 class="mt-3 text-[24px] leading-[1.15] font-bold tracking-[-0.014em] text-text-primary">{way.name}</h3>
              <p class="mt-1.5 text-[15.5px] leading-[1.5] text-text-secondary">{way.line}</p>
              <ul class="mt-4 mb-5 grid gap-2">
                {way.checks.map((check) => (
                  <li class="flex items-center gap-2 text-[15px] leading-[1.4] text-text-primary">
                    <img src="/brand/home/two-ways/check.svg" alt="" width="18" height="18" class="size-[18px] shrink-0" />
                    {check}
                  </li>
                ))}
              </ul>
              <div class="mt-auto flex items-center justify-between gap-4 border-t border-border-default pt-4">
                <p class="text-[14px] leading-[1.45] text-text-tertiary">
                  <strong class="font-semibold text-text-primary">Best for:</strong> {way.bestFor}
                </p>
                <button type="button" class={btn}>
                  {way.cta} <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
</div>

<script>
  import "../../scripts/home-bottom/book-buttons.ts";
</script>
