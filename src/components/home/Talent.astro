---
---

<div data-section-view="talent">
  <section id="talent" aria-labelledby="talent-heading" class="pb-20 lg:pb-24">
    <div class="mx-auto max-w-[810px] px-6 text-center">
      <div>
        <h2
          id="talent-heading"
          class="text-[36px] leading-[1.2] font-medium tracking-[-0.04em] text-balance text-text-primary md:text-[54px]"
        >
          <span class="block">Leverage</span>{" "}
          <span class="block text-gradient-conversation">
            world-class talent
          </span>
        </h2>
      </div>
      <div>
        <p class="mx-auto mt-7 max-w-[770px] text-lg leading-[1.55] tracking-[-0.014em] text-text-secondary">
          We are the largest, globally distributed network of top business,
          design, and technology talent, ready to tackle your most important
          initiatives.
        </p>
      </div>
    </div>
    <div class="hd-talent-grid relative mt-12 lg:mt-[57px]" data-motion="talent-grid">
      <span class="hd-rule hd-rule-top" aria-hidden="true"></span>
      <span class="hd-rule hd-rule-bottom" aria-hidden="true"></span>
      <span class="hd-rule hd-rule-col" style="--col:1" aria-hidden="true"></span>
      <span class="hd-rule hd-rule-col" style="--col:2" aria-hidden="true"></span>
      <ul class="grid overflow-hidden border-y border-border-default bg-background-raised md:grid-cols-3">
        <li class="border-b border-border-default last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
          <div class="h-full" style="--i:0">
            <article class="www-talent-card relative flex h-full flex-col">
              <div class="relative z-[1] aspect-[480/310] overflow-hidden bg-background-neutral-subtle">
                <img
                  src="/brand/talent-cards/developers-750.jpg"
                  srcset="/brand/talent-cards/developers-750.jpg 750w, /brand/talent-cards/developers-1500.jpg 1500w"
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt="A team of engineers smiling around a meeting table"
                  loading="lazy"
                  decoding="async"
                  class="www-talent-photo size-full object-cover"
                />
                <img
                  src="/brand/talent-cards/developers-750.jpg"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  class="hd-blur-twin"
                />
              </div>
              <div class="relative z-[1] flex flex-1 flex-col items-start gap-3.5 px-6 pt-8 pb-7 lg:gap-3 lg:px-8 lg:pt-6 lg:pb-6">
                <h3 class="text-[22px] leading-[1.2] font-semibold tracking-[-0.02em] text-text-primary">
                  Developers
                </h3>
                <p class="mb-2.5 flex-1 text-base leading-[1.56] text-text-secondary lg:mb-1">
                  Seasoned software engineers, coders, and architects with
                  expertise across hundreds of technologies.
                </p>
                <a
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold"
                  aria-label="Find Talent: Developers"
                  href="/hire/engineering"
                >
                  Find Talent <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </div>
        </li>
        <li class="border-b border-border-default last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
          <div class="h-full" style="--i:1">
            <article class="www-talent-card relative flex h-full flex-col">
              <div class="relative z-[1] aspect-[480/310] overflow-hidden bg-background-neutral-subtle">
                <img
                  src="/brand/talent-cards/designers-750.jpg"
                  srcset="/brand/talent-cards/designers-750.jpg 750w, /brand/talent-cards/designers-960.jpg 960w"
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt="Portrait of a smiling designer in an office"
                  loading="lazy"
                  decoding="async"
                  class="www-talent-photo size-full object-cover"
                />
                <img
                  src="/brand/talent-cards/designers-750.jpg"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  class="hd-blur-twin"
                />
              </div>
              <div class="relative z-[1] flex flex-1 flex-col items-start gap-3.5 px-6 pt-8 pb-7 lg:gap-3 lg:px-8 lg:pt-6 lg:pb-6">
                <h3 class="text-[22px] leading-[1.2] font-semibold tracking-[-0.02em] text-text-primary">
                  Designers
                </h3>
                <p class="mb-2.5 flex-1 text-base leading-[1.56] text-text-secondary lg:mb-1">
                  Expert UI, UX, visual, and interaction designers, as well as
                  illustrators, animators, and more.
                </p>
                <a
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold"
                  aria-label="Find Talent: Designers"
                  href="/hire/design"
                >
                  Find Talent <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </div>
        </li>
        <li class="border-b border-border-default last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
          <div class="h-full" style="--i:2">
            <article class="www-talent-card relative flex h-full flex-col">
              <div class="relative z-[1] aspect-[480/310] overflow-hidden bg-background-neutral-subtle">
                <img
                  src="/brand/talent-cards/ai-data-750.jpg"
                  srcset="/brand/talent-cards/ai-data-750.jpg 750w, /brand/talent-cards/ai-data-960.jpg 960w"
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt="Portrait of a specialist in front of a screen"
                  loading="lazy"
                  decoding="async"
                  class="www-talent-photo size-full object-cover"
                />
                <img
                  src="/brand/talent-cards/ai-data-750.jpg"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  class="hd-blur-twin"
                />
              </div>
              <div class="relative z-[1] flex flex-1 flex-col items-start gap-3.5 px-6 pt-8 pb-7 lg:gap-3 lg:px-8 lg:pt-6 lg:pb-6">
                <h3 class="text-[22px] leading-[1.2] font-semibold tracking-[-0.02em] text-text-primary">
                  Marketing Experts
                </h3>
                <p class="mb-2.5 flex-1 text-base leading-[1.56] text-text-secondary lg:mb-1">
                  Experts in digital marketing, growth marketing, content
                  creation, research, and brand strategy.
                </p>
                <a
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold"
                  aria-label="Find Talent: Marketing Experts"
                  href="/hire"
                >
                  Find Talent <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </div>
        </li>
      </ul>
    </div>
  </section>
</div>

<script>
  import "../../scripts/home-top/talent-cards.ts";
</script>
