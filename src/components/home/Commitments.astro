---
---

<div data-section-view="commitments">
  <div data-reveal="out">
    <section
      id="commitments"
      aria-labelledby="partner-heading"
      class="www-partner relative scroll-mt-24 px-6 py-24 md:py-[70px]"
    >
      <span
        aria-hidden="true"
        class="www-partner-glow left-[4%] top-[48%]"
      ></span>
      <span
        aria-hidden="true"
        class="www-partner-glow left-[56%] top-[46%]"
      ></span>
      <h2
        id="partner-heading"
        class="relative mx-auto max-w-[656px] text-center text-[40px] leading-[1.2] font-medium tracking-[-0.04em] text-balance text-text-primary md:text-[58px]"
      >
        A partner for the whole engagement,{" "}
        <span class="text-gradient-conversation">not just the hire.</span>
      </h2>
      <ul class="relative mx-auto mt-[60px] grid max-w-[1116px] gap-6 md:grid-cols-3 md:gap-[60px]">
        <li>
          <article class="flex h-full flex-col gap-3 rounded-[15px] bg-background-raised px-[37px] py-[35px] shadow-[0_4px_1.55px_rgb(165_165_165/0.08)]">
            <h3 class="text-[18px] leading-[30.45px] font-medium tracking-[-0.023em] text-text-accent">
              One partner on our side
            </h3>
            <p class="text-[18px] leading-[30.45px] font-medium tracking-[-0.023em] text-text-primary">
              From your first message to long after your specialist starts. You
              always know who to call.
            </p>
          </article>
        </li>
        <li>
          <article class="flex h-full flex-col gap-3 rounded-[15px] bg-background-raised px-[37px] py-[35px] shadow-[0_4px_1.55px_rgb(165_165_165/0.08)]">
            <h3 class="text-[18px] leading-[30.45px] font-medium tracking-[-0.023em] text-text-accent">
              Part of your team
            </h3>
            <p class="text-[18px] leading-[30.45px] font-medium tracking-[-0.023em] text-text-primary">
              Your tools, your rituals, your roadmap, the way an in-house hire
              works.
            </p>
          </article>
        </li>
        <li>
          <article class="flex h-full flex-col gap-3 rounded-[15px] bg-background-raised px-[37px] py-[35px] shadow-[0_4px_1.55px_rgb(165_165_165/0.08)]">
            <h3 class="text-[18px] leading-[30.45px] font-medium tracking-[-0.023em] text-text-accent">
              Every decision is yours
            </h3>
            <p class="text-[18px] leading-[30.45px] font-medium tracking-[-0.023em] text-text-primary">
              You approve the role and the terms, choose who to interview, and
              decide who joins.
            </p>
          </article>
        </li>
      </ul>
    </section>
  </div>
</div>
