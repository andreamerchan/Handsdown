---
---

<div data-section-view="how-it-works">
  <section
    id="how-it-works"
    aria-labelledby="how-we-work-title"
    data-layout="unmeasured"
    class="www-hwws"
  >
    <div class="www-hwws-head mx-auto max-w-[856px] px-6 text-center">
      <p class="font-mono text-[14px] leading-[1.2] font-medium tracking-[-0.02em] text-text-tertiary uppercase">
        How we work
      </p>
      <h2
        id="how-we-work-title"
        class="mt-[11px] text-[clamp(40px,4.2vw,54px)] leading-[1.2] font-medium tracking-[-0.04em] text-balance text-text-primary"
      >
        <span class="block">Less hiring.</span>{" "}
        <span class="block text-gradient-conversation">More building.</span>
      </h2>
      <p class="mt-10 font-mono text-[12px] leading-[30px] tracking-[-0.04em] text-text-tertiary uppercase">
        Scroll to continue
      </p>
    </div>
    <div data-hwws-track="true" class="www-hwws-track">
      <div data-hwws-stage="true" class="www-hwws-stage">
        <div class="www-hwws-steps">
          <article data-step="describe" class="www-hwws-step">
            <div class="www-hwws-row">
              <div class="www-hww-text">
                <p class="font-mono text-[18px] leading-[1.2] tracking-[1px] text-text-tertiary uppercase">
                  Step 1
                </p>
                <h3 class="mt-[9px] text-[clamp(32px,3.4vw,48px)] leading-[1.2] font-medium tracking-[-0.043em] text-balance text-text-primary [&>span+span]:mt-[9px] relative">
                  <span class="block text-gradient-heading">
                    Describe the role{" "}
                  </span>
                  <span class="absolute top-[2.079em] left-[11.727em] !mt-0 text-[0.458em] leading-[1.2] font-medium tracking-[-0.02em] whitespace-nowrap text-indigo-600 italic">
                    or what you need{" "}
                  </span>
                  <span class="block">We turn it into a </span>
                  <span class="block">science-backed spec.</span>
                </h3>
                <p class="mt-[9px] max-w-[440px] text-base leading-[1.37] font-medium tracking-[-0.04em] text-text-tertiary">
                  <span class="lg:block">
                    The same questions and the same scale for everyone,{" "}
                  </span>
                  <span class="lg:block">
                    so you compare people fairly and see the evidence{" "}
                  </span>
                  <span class="lg:block">behind every score.</span>
                </p>
                <button
                  type="button"
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-5 lg:h-[38px] lg:px-4 lg:text-[14px] lg:font-medium lg:tracking-[-0.02em]"
                >
                  Describe your role
                </button>
              </div>
              <div class="www-hww-spec" aria-hidden="true">
                <p class="www-hww-bubble">
                  “We need a senior data scientist for machine learning work, on
                  US hours.”
                </p>
                <span class="www-hww-link"></span>
                <div class="www-hww-card relative w-full overflow-hidden px-4 pt-3.5 pb-2.5">
                  <span class="www-hww-scan"></span>
                  <div class="flex items-center justify-between border-b border-border-default pb-3">
                    <b class="text-sm font-semibold text-text-primary">
                      Your role spec
                    </b>
                    <span class="rounded-full bg-background-brand-subtle px-2.5 text-[11px] leading-[22px] font-semibold text-text-accent">
                      Free
                    </span>
                  </div>
                  <dl>
                    <div
                      class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                      style="--i:0"
                    >
                      <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                        Role
                      </dt>
                      <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                        Senior Data Scientist
                      </dd>
                      <dd class="justify-self-end">
                        <span class="www-hww-badge">
                          <span
                            class="www-hww-badge-wait"
                            aria-hidden="true"
                          ></span>
                          <span class="www-hww-badge-done">
                            <svg
                              viewBox="0 0 10 10"
                              aria-hidden="true"
                              class="size-2.5"
                            >
                              <path
                                d="M1.8 5.3 4 7.4 8.2 2.8"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            Clear
                          </span>
                        </span>
                      </dd>
                    </div>
                    <div
                      class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                      style="--i:1"
                    >
                      <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                        Skills
                      </dt>
                      <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                        Python · Machine Learning
                      </dd>
                      <dd class="justify-self-end">
                        <span class="www-hww-badge">
                          <span
                            class="www-hww-badge-wait"
                            aria-hidden="true"
                          ></span>
                          <span class="www-hww-badge-done">
                            <svg
                              viewBox="0 0 10 10"
                              aria-hidden="true"
                              class="size-2.5"
                            >
                              <path
                                d="M1.8 5.3 4 7.4 8.2 2.8"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            Weighted
                          </span>
                        </span>
                      </dd>
                    </div>
                    <div
                      class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                      style="--i:2"
                    >
                      <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                        Hours
                      </dt>
                      <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                        US overlap
                      </dd>
                      <dd class="justify-self-end">
                        <span class="www-hww-badge">
                          <span
                            class="www-hww-badge-wait"
                            aria-hidden="true"
                          ></span>
                          <span class="www-hww-badge-done">
                            <svg
                              viewBox="0 0 10 10"
                              aria-hidden="true"
                              class="size-2.5"
                            >
                              <path
                                d="M1.8 5.3 4 7.4 8.2 2.8"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            Confirmed
                          </span>
                        </span>
                      </dd>
                    </div>
                    <div
                      class="www-hww-row grid min-h-[37px] grid-cols-[62px_1fr_auto] items-center gap-2 border-b border-border-default py-[7px] last:border-b-0"
                      style="--i:3"
                    >
                      <dt class="font-mono text-[8.5px] leading-[1.35] tracking-[0.1em] text-text-tertiary uppercase">
                        Tested by
                      </dt>
                      <dd class="text-[13.5px] leading-[1.3] font-medium text-text-primary">
                        Work sample · Structured interview
                      </dd>
                      <dd class="justify-self-end">
                        <span class="www-hww-badge">
                          <span
                            class="www-hww-badge-wait"
                            aria-hidden="true"
                          ></span>
                          <span class="www-hww-badge-done">
                            <svg
                              viewBox="0 0 10 10"
                              aria-hidden="true"
                              class="size-2.5"
                            >
                              <path
                                d="M1.8 5.3 4 7.4 8.2 2.8"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            Proven
                          </span>
                        </span>
                      </dd>
                    </div>
                  </dl>
                </div>
              </div>
            </div>
          </article>
          <article data-step="search" class="www-hwws-step">
            <div class="www-hwws-row">
              <div class="www-hww-text">
                <p class="font-mono text-[18px] leading-[1.2] tracking-[1px] text-text-tertiary uppercase">
                  Step 2
                </p>
                <h3 class="mt-[9px] text-[clamp(32px,3.4vw,48px)] leading-[1.2] font-medium tracking-[-0.043em] text-balance text-text-primary [&>span+span]:mt-[9px]">
                  <span class="block">We search across </span>
                  <span class="block text-gradient-heading">
                    Latin America{" "}
                  </span>
                  <span class="block">for your role.</span>
                </h3>
                <p class="mt-[9px] max-w-[440px] text-base leading-[1.37] font-medium tracking-[-0.04em] text-text-tertiary">
                  <span class="lg:block">
                    Senior specialists from Mexico to Argentina, matched{" "}
                  </span>
                  <span class="lg:block">
                    against your spec and working in real time with your team.
                  </span>
                </p>
                <button
                  type="button"
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-5 lg:h-[38px] lg:px-4 lg:text-[14px] lg:font-medium lg:tracking-[-0.02em]"
                >
                  Describe your role
                </button>
              </div>
              <div class="www-hwws-map" aria-hidden="true">
                <div class="www-hwws-dots-frame">
                  <canvas class="www-hwws-dots"></canvas>
                </div>
                <span
                  class="www-hwws-pin"
                  style="left:49.166666666666664%;top:33.87550200803213%;--i:0"
                ></span>
                <span
                  class="www-hwws-pin"
                  style="left:69.03703703703704%;top:46.22489959839357%;--i:1"
                ></span>
                <span
                  class="www-hwws-pin"
                  style="left:66.55555555555556%;top:60.70281124497993%;--i:2"
                ></span>
                <span
                  class="www-hwws-pin"
                  style="left:81.94444444444444%;top:80.66265060240964%;--i:3"
                ></span>
                <span
                  class="www-hwws-marker"
                  style="left:56.98148148148148%;top:72.67068273092369%"
                >
                  E
                </span>
                <div class="www-hwws-matched">
                  <span class="grid size-[42px] flex-none place-items-center rounded-full bg-slate-700 text-[14.5px] font-medium text-text-inverse-primary">
                    E
                  </span>
                  <span class="min-w-0">
                    <b class="block text-[17px] leading-[1.2] font-semibold text-text-primary">
                      Edson
                    </b>
                    <span class="mt-[7px] block truncate text-[14.5px] leading-[1.2] text-text-tertiary">
                      Senior Data Scientist · São Paulo
                    </span>
                  </span>
                  <span class="rounded-full bg-background-success-subtle px-[11px] text-[13.5px] leading-[28px] font-medium text-text-success">
                    Matched
                  </span>
                </div>
              </div>
            </div>
          </article>
          <article data-step="checks" class="www-hwws-step">
            <div class="www-hwws-row">
              <div class="www-hww-text">
                <p class="font-mono text-[18px] leading-[1.2] tracking-[1px] text-text-tertiary uppercase">
                  Step 3
                </p>
                <h3 class="mt-[9px] text-[clamp(32px,3.4vw,48px)] leading-[1.2] font-medium tracking-[-0.043em] text-balance text-text-primary [&>span+span]:mt-[9px]">
                  <span class="block">Every candidate goes </span>
                  <span class="block text-gradient-heading">
                    through five checks.
                  </span>
                </h3>
                <p class="mt-[9px] max-w-[440px] text-base leading-[1.37] font-medium tracking-[-0.04em] text-text-tertiary">
                  <span class="lg:block">
                    The same questions and the same scale for everyone,{" "}
                  </span>
                  <span class="lg:block">
                    so you compare people fairly and see the evidence{" "}
                  </span>
                  <span class="lg:block">behind every score.</span>
                </p>
                <button
                  type="button"
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-5 lg:h-[38px] lg:px-4 lg:text-[14px] lg:font-medium lg:tracking-[-0.02em]"
                >
                  Describe your role
                </button>
              </div>
              <div class="www-hwws-score" aria-hidden="true">
                <ol class="grid gap-9">
                  <li data-state="done" class="www-hwws-check" style="--i:0">
                    <span class="www-hwws-mark"></span>
                    <span class="min-w-0">
                      <b class="block text-[16px] leading-[1.2] font-medium tracking-[-0.02em]">
                        Skills screen
                      </b>
                      <span class="www-hwws-line">
                        Scored against your Role Spec
                      </span>
                    </span>
                    <span class="www-hwws-result">4.5</span>
                  </li>
                  <li data-state="done" class="www-hwws-check" style="--i:1">
                    <span class="www-hwws-mark"></span>
                    <span class="min-w-0">
                      <b class="block text-[16px] leading-[1.2] font-medium tracking-[-0.02em]">
                        Structured interview
                      </b>
                      <span class="www-hwws-line">
                        Same questions, fixed rating scale
                      </span>
                    </span>
                    <span class="www-hwws-result">4.3</span>
                  </li>
                  <li data-state="done" class="www-hwws-check" style="--i:2">
                    <span class="www-hwws-mark"></span>
                    <span class="min-w-0">
                      <b class="block text-[16px] leading-[1.2] font-medium tracking-[-0.02em]">
                        Work sample
                      </b>
                      <span class="www-hwws-line">
                        Real task, AI tools allowed
                      </span>
                      <span class="www-hwws-line whitespace-pre">
                        {" "}
                        ↳ Uses AI well: checks output, catches errors
                      </span>
                    </span>
                    <span class="www-hwws-result">4.5</span>
                  </li>
                  <li data-state="current" class="www-hwws-check" style="--i:3">
                    <span class="www-hwws-mark"></span>
                    <span class="min-w-0">
                      <b class="block text-[16px] leading-[1.2] font-medium tracking-[-0.02em]">
                        Fit check
                      </b>
                      <span class="www-hwws-line">
                        Work style and goals vs. your team
                      </span>
                    </span>
                    <span class="www-hwws-result">Strong</span>
                  </li>
                  <li data-state="next" class="www-hwws-check" style="--i:4">
                    <span class="www-hwws-mark"></span>
                    <span class="min-w-0">
                      <b class="block text-[16px] leading-[1.2] font-medium tracking-[-0.02em]">
                        Fairness check
                      </b>
                      <span class="www-hwws-line">
                        Scoring audited for bias before ranking
                      </span>
                    </span>
                    <span class="www-hwws-result">Passed</span>
                  </li>
                </ol>
              </div>
            </div>
          </article>
          <article data-step="shortlist" class="www-hwws-step">
            <div class="www-hwws-row">
              <div class="www-hww-text">
                <p class="font-mono text-[18px] leading-[1.2] tracking-[1px] text-text-tertiary uppercase">
                  Step 4
                </p>
                <h3 class="mt-[9px] text-[clamp(32px,3.4vw,48px)] leading-[1.2] font-medium tracking-[-0.043em] text-balance text-text-primary [&>span+span]:mt-[9px]">
                  <span class="block text-gradient-heading">
                    You meet a shortlist,{" "}
                  </span>
                  <span class="block">not a pile of CVs.</span>
                </h3>
                <p class="mt-[9px] max-w-[440px] text-base leading-[1.37] font-medium tracking-[-0.04em] text-text-tertiary">
                  <span class="lg:block">
                    Specialists who already said yes to your role, each{" "}
                  </span>
                  <span class="lg:block">
                    scored against it. You interview, you decide, and we{" "}
                  </span>
                  <span class="lg:block">stay with you after they start.</span>
                </p>
                <button
                  type="button"
                  class="inline-flex items-center justify-center gap-2 rounded-full transition duration-120 ease-standard hover:-translate-y-px active:translate-y-px focus-visible:shadow-ring focus-visible:outline-none disabled:pointer-events-none disabled:bg-background-disabled disabled:text-text-disabled disabled:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-slate-800 bg-background-inverted text-text-inverse-primary shadow-dark-btn hover:bg-background-inverted-hover h-11 px-6 text-[15px] font-semibold mt-5 lg:h-[38px] lg:px-4 lg:text-[14px] lg:font-medium lg:tracking-[-0.02em]"
                >
                  Describe your role
                </button>
              </div>
              <div class="www-hww-shortlist" aria-hidden="true">
                <ul class="grid w-full gap-2.5">
                  <li data-top="true" class="www-hww-cv" style="--i:0">
                    <span class="www-hww-cv-avatar">E</span>
                    <span>
                      <b class="block text-sm leading-[1.2] font-semibold">
                        Candidate A
                      </b>
                      <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                        Scored against your role
                      </span>
                    </span>
                    <span class="www-hww-bars">
                      <i></i>
                      <i></i>
                      <i></i>
                      <i></i>
                    </span>
                  </li>
                  <li class="www-hww-cv" style="--i:1">
                    <span class="www-hww-cv-avatar">B</span>
                    <span>
                      <b class="block text-sm leading-[1.2] font-semibold">
                        Candidate B
                      </b>
                      <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                        Scored against your role
                      </span>
                    </span>
                    <span class="www-hww-bars">
                      <i></i>
                      <i></i>
                      <i></i>
                      <i></i>
                    </span>
                  </li>
                  <li class="www-hww-cv" style="--i:2">
                    <span class="www-hww-cv-avatar">C</span>
                    <span>
                      <b class="block text-sm leading-[1.2] font-semibold">
                        Candidate C
                      </b>
                      <span class="mt-[5px] block text-xs leading-none text-text-tertiary">
                        Scored against your role
                      </span>
                    </span>
                    <span class="www-hww-bars">
                      <i></i>
                      <i></i>
                      <i></i>
                      <i></i>
                    </span>
                  </li>
                </ul>
                <span class="www-hww-link www-hww-link-short"></span>
                <p class="www-hww-decide">You interview. You decide.</p>
                <ul class="mt-3 flex gap-1.5">
                  <li class="www-hww-day" style="--i:0">
                    Day 30
                  </li>
                  <li class="www-hww-day" style="--i:1">
                    Day 60
                  </li>
                  <li class="www-hww-day" style="--i:2">
                    Day 90
                  </li>
                </ul>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>
</div>
